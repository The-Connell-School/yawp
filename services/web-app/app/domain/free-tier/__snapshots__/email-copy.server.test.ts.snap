// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`release email snapshot 1`] = `
"Hi Ada,

You're in — we'd love to have you try Yawp! with your students.

Create your teacher account to get started:
https://yawp.school/join

This link is for you only and expires in 30 days.

— The Yawp! team"
`;

exports[`admin approval email ignores a custom note and retains links 1`] = `
"Approve Yawp! for Ada at Example HS

Ada at Example HS would like to use Yawp! in their classroom. They named you as the administrator who can approve classroom software.

Ada
Teacher at Example HS
ada@example.edu

Students draft essays with feedback as they write.
Teachers control assignments and grading.
Student writing is never used to train outside models.

Review and approve:
https://yawp.school/a

Not the right person? Forward this request:
https://yawp.school/n

This link works for 14 days. You don't need a Yawp! account.

Sent by Yawp! · yawp.school"
`;
