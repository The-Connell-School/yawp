AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
SESSION_SECRET=
# Preview/demo access gate only. Must be independent from SESSION_SECRET.
PREVIEW_ACCESS_SECRET=
HONEYPOT_SECRET=
INTERNAL_COMMAND_TOKEN=
SENTRY_AUTH_TOKEN=
OPENAI_API_KEY=
OPENAI_ORG=
ANTHROPIC_API_KEY=
EMAIL_PROVIDER=resend
AWS_SES_REGION=us-east-1
SES_FROM_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# University of Alabama student billing. Disabled unless explicitly set to true.
UA_STUDENT_BILLING_ENABLED=false
UA_ORGANIZATION_ID=
# Student-facing organization code accepted by /ua routes and remembered on-device.
UA_PARTNER_CODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_UA_2026_PRICE_ID=
# Canonical public origin used for Stripe success/cancel URLs. No path.
YAWP_APP_ORIGIN=https://yawp.school
# Comma-separated legacy subscription prices accepted by the dry-run-first
# UA existing-subscriber reconciliation command. This is separate from the new
# one-time checkout price above.
STRIPE_UA_EXISTING_SUBSCRIPTION_PRICE_IDS=

# Admin Marketing Studio. All three are required: the studio stays off unless
# MARKETING_RENDER_TARGET_IS_DEMO explicitly states the target holds demo data,
# and the target host must be localhost, a preview, or the demo box.
# scripts/worktree-local-setup.sh sets these for local development.
MARKETING_STUDIO_ENABLED=off
MARKETING_RENDER_TARGET_URL=
MARKETING_RENDER_TARGET_IS_DEMO=
# Serve renders from a directory instead of signing S3 URLs (no AWS needed).
MARKETING_MEDIA_STORAGE=
MARKETING_MEDIA_DIR=
