    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.804.0",
    "bun-types": "^1.2.12",
    "prisma": "^6.7.0",
    "typescript": "^5.4.2"
  }
