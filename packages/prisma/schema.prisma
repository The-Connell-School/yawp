generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AssistantConfiguration {
  id          String  @id
  assistantId String  @unique
  pin         String
  actionText  String?
  description String?
}

model AssistantMetadata {
  id          String   @id
  assistantId String
  isVerified  Boolean  @default(false)
  userId      String
  User        User     @relation(fields: [userId], references: [id])
  Thread      Thread[]
}

model Connection {
  id           String   @id
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @db.Timestamptz(6)
  providerName String
  providerId   String
  userId       String
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerName, providerId])
}

model Course {
  id             String           @id
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @db.Timestamptz(6)
  title          String
  description    String?
  position       Int
  CourseImage    CourseImage?
  CourseModule   CourseModule[]
  CourseResource CourseResource[]
}

model CourseImage {
  id          String   @id
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  altText     String?
  contentType String
  blob        Bytes
  courseId    String   @unique
  Course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseModule {
  id                      String                    @id
  createdAt               DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                  @default(now()) @db.Timestamptz(6)
  deletedAt               DateTime?                 @db.Timestamptz(6)
  title                   String
  position                Int
  description             String?
  tutorInstructions       String?
  isSelfGuided            Boolean                   @default(false)
  courseId                String?
  Course                  Course?                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  CourseModuleInstruction CourseModuleInstruction[]
  CourseModuleSession     CourseModuleSession[]
}

model CourseModuleInstruction {
  id                      String            @id
  createdAt               DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime          @default(now()) @db.Timestamptz(6)
  courseModuleId          String
  position                Int
  title                   String
  interactiveType         String
  prompt                  String
  tutorInstructions       String?
  answerType              String?
  answerKey               String?
  answerTypeOptions       String?
  canAskQuestion          Boolean?          @default(false)
  nextInstructionBtnLabel String?
  CourseModule            CourseModule      @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  InstructionAudio        InstructionAudio?
}

model CourseModuleSession {
  id                         String                       @id
  createdAt                  DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                     @default(now()) @db.Timestamptz(6)
  deletedAt                  DateTime?                    @db.Timestamptz(6)
  title                      String                       @default("Untitled")
  instructionsCompleted      Int
  courseModuleId             String
  userId                     String
  documentId                 String
  CourseModule               CourseModule                 @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  Document                   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  User                       User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  CourseModuleSessionMessage CourseModuleSessionMessage[]
}

model CourseModuleSessionMessage {
  id                    String              @id
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  courseModuleSessionId String
  instructionId         String
  content               String
  agent                 String
  factCheckPrompt       String?
  context               String?
  CourseModuleSession   CourseModuleSession @relation(fields: [courseModuleSessionId], references: [id], onDelete: Cascade)
}

model CourseResource {
  id          String   @id
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  title       String
  description String?
  url         String?
  courseId    String
  Course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Document {
  id                  String                @id
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @db.Timestamptz(6)
  deletedAt           DateTime?             @db.Timestamptz(6)
  title               String                @default("Untitled")
  text                String?
  html                String?
  userId              String
  CourseModuleSession CourseModuleSession[]
  User                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  DocumentComment     DocumentComment[]
  DocumentVersion     DocumentVersion[]
}

model DocumentComment {
  id                      String                    @id
  createdAt               DateTime                  @default(now()) @db.Timestamptz(6)
  userId                  String
  content                 String
  highlightId             String?
  documentId              String
  Document                Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  User                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  DocumentCommentResponse DocumentCommentResponse[]
}

model DocumentCommentResponse {
  id              String          @id
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  commentId       String
  userId          String
  content         String
  DocumentComment DocumentComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  User            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DocumentVersion {
  id         String   @id
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  documentId String
  text       String
  html       String
  Document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id          String   @id
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  name        String   @unique
  description String?
  isEnabled   Boolean  @default(false)
}

model InstructionAudio {
  id                        String                  @id
  createdAt                 DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                @default(now()) @db.Timestamptz(6)
  blob                      Bytes
  courseModuleInstructionId String                  @unique
  CourseModuleInstruction   CourseModuleInstruction @relation(fields: [courseModuleInstructionId], references: [id], onDelete: Cascade)
}

model Password {
  hash   String
  userId String @unique
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Permission {
  id          String   @id
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  action      String
  entity      String
  access      String
  description String   @default("")
  Role        Role[]

  @@unique([action, entity, access])
}

model Role {
  id          String       @id
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @db.Timestamptz(6)
  name        String       @unique
  description String       @default("")
  Permission  Permission[]
  User        User[]
}

model Session {
  id             String   @id
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)
  expirationDate DateTime @default(now()) @db.Timestamptz(6)
  userId         String
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id        String   @id
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  name      String   @unique
  value     String
  valueType String   @default("string")
}

model StudentProfile {
  id                                         String   @id
  createdAt                                  DateTime @default(now()) @db.Timestamptz(6)
  userId                                     String   @unique
  workshopLeaderId                           String?
  school                                     String?
  schoolTeacher                              String?
  grade                                      String?
  period                                     String?
  User_StudentProfile_userIdToUser           User     @relation("StudentProfile_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)
  User_StudentProfile_workshopLeaderIdToUser User?    @relation("StudentProfile_workshopLeaderIdToUser", fields: [workshopLeaderId], references: [id])
}

model StudentView {
  id             String   @id
  name           String
  school         String?
  grade          String?
  period         String?
  workshopLeader String?
  schoolTeacher  String?
  userId         String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id        String   @id
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  userId    String   @unique
  isActive  Boolean  @default(true)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Thread {
  id                  String            @id
  threadId            String            @unique
  name                String
  assistantMetadataId String
  AssistantMetadata   AssistantMetadata @relation(fields: [assistantMetadataId], references: [id], onDelete: Cascade)
}

model Upload {
  id          String    @id
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  name        String
  contentType String
  blob        Bytes
  userId      String
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                                                   String                    @id
  createdAt                                            DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                                            DateTime                  @default(now()) @db.Timestamptz(6)
  email                                                String                    @unique
  name                                                 String?
  AssistantMetadata                                    AssistantMetadata[]
  Connection                                           Connection[]
  CourseModuleSession                                  CourseModuleSession[]
  Document                                             Document[]
  DocumentComment                                      DocumentComment[]
  DocumentCommentResponse                              DocumentCommentResponse[]
  Password                                             Password?
  Session                                              Session[]
  StudentProfile_StudentProfile_userIdToUser           StudentProfile?           @relation("StudentProfile_userIdToUser")
  StudentProfile_StudentProfile_workshopLeaderIdToUser StudentProfile[]          @relation("StudentProfile_workshopLeaderIdToUser")
  StudentView                                          StudentView[]
  TeacherProfile                                       TeacherProfile?
  Upload                                               Upload[]
  UserImage                                            UserImage?
  Role                                                 Role[]
}

model UserImage {
  id          String   @id
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  altText     String?
  contentType String
  blob        Bytes
  userId      String   @unique
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id        String    @id
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  type      String
  target    String
  secret    String
  algorithm String
  digits    Int
  period    Int
  charSet   String
  expiresAt DateTime? @db.Timestamptz(6)
  metadata  String?

  @@unique([target, type])
}
