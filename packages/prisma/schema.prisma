generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  TEACHER
  STUDENT
}

model Class {
  id               String            @id @default(cuid())
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @db.Timestamptz(6)
  code             String
  schoolYear       String            @default("2024-2025")
  period           String
  grade            String
  title            String?
  cardGradientKey  String            @default("indigo-purple-pink")
  classArtIndex    Int?
  classArtKey      String?
  isArchived       Boolean           @default(false)
  students         OrgMembership[]   @relation("ClassStudents")
  teachers         OrgMembership[]   @relation("ClassTeachers")
  schoolId         String
  school           School            @relation(fields: [schoolId], references: [id])
  classAssignments ClassAssignment[]

  writingPracticeClassAssignments WritingPracticeClassAssignment[]
  ltiCourseMappings               LtiCourseMapping[]

  @@unique([schoolId, code])
  @@index([schoolId, schoolYear, period, grade])
}

model AssignmentType {
  id                                 String                        @id @default(cuid())
  createdAt                          DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt                          DateTime                      @default(now()) @db.Timestamptz(6)
  title                              String
  kind                               String?                       @unique
  description                        String?
  position                           Int
  systemKey                          String?                       @unique
  archivedAt                         DateTime?                     @db.Timestamptz(6)
  ownerOrgId                         String?
  ownerOrg                           Organization?                 @relation(fields: [ownerOrgId], references: [id], onDelete: Cascade)
  ownerMembershipId                  String?
  ownerMembership                    OrgMembership?                @relation("AssignmentTypeOwner", fields: [ownerMembershipId], references: [id], onDelete: Cascade)
  scoringScaleJson                   Json?
  rubricJson                         Json?
  gradingPromptConfigJson            Json?
  gradingOutputSchemaJson            Json?
  gradingCalibrationNotes            String?
  gradingAssistantVersion            Int                           @default(1)
  gradingAssistantSourceTemplateId   String?
  gradingAssistantSourceTemplateSlug String?
  image                              AssignmentTypeImage?
  organizationAssignments            OrganizationAssignmentType[]
  schoolAssignments                  SchoolAssignmentType[]
  teacherAssignments                 TeacherAssignmentType[]
  assignmentModules                  AssignmentModule[]
  assignments                        Assignment[]
  documents                          Document[]
  apHistoryLibraryEntries            ApHistoryPromptLibraryEntry[]

  @@index([ownerOrgId])
  @@index([ownerMembershipId])
  @@index([archivedAt])
  @@index([systemKey])
  @@index([kind])
}

model Assignment {
  id                              String            @id @default(cuid())
  createdAt                       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime          @default(now()) @db.Timestamptz(6)
  assignmentTypeId                String
  assignmentType                  AssignmentType    @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
  title                           String?
  prompt                          String
  submitForGrade                  Boolean           @default(true)
  pointValue                      Int?              @default(100)
  gradingAssistantStrictnessLevel String            @default("intermediate")
  apHistorySnapshot               Json?
  classAssignments                ClassAssignment[]
  documents                       Document[]

  @@index([assignmentTypeId])
}

model ClassAssignment {
  id            String                  @id @default(cuid())
  createdAt     DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                @default(now()) @db.Timestamptz(6)
  assignmentId  String
  assignment    Assignment              @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  classId       String
  class         Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  documents     Document[]
  insight       ClassAssignmentInsight?
  ltiPlacements LtiPlacement[]

  @@unique([assignmentId, classId])
  @@index([classId, createdAt(sort: Desc)])
}

/// Class-wide, assignment-level feedback for the teacher: an AI summary of how
/// the whole class did on one assignment (strengths, gaps, teaching next steps).
/// One cached row per ClassAssignment; regenerated on demand.
model ClassAssignmentInsight {
  id                      String          @id @default(cuid())
  createdAt               DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  classAssignmentId       String          @unique
  classAssignment         ClassAssignment @relation(fields: [classAssignmentId], references: [id], onDelete: Cascade)
  status                  String          @default("ready") // ready | failed
  model                   String?
  submissionCount         Int             @default(0)
  summaryJson             Json?
  generatedByMembershipId String?
  generatedByMembership   OrgMembership?  @relation(fields: [generatedByMembershipId], references: [id], onDelete: SetNull)
  generatedAt             DateTime?       @db.Timestamptz(6)

  @@index([generatedByMembershipId])
}

model ApHistoryPromptLibraryEntry {
  id                     String                         @id @default(cuid())
  createdAt              DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                       @default(now()) @updatedAt @db.Timestamptz(6)
  externalKey            String                         @unique
  assignmentTypeId       String
  assignmentType         AssignmentType                 @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
  course                 String
  essayType              String
  title                  String
  prompt                 String
  period                 String
  periodNumber           Int
  reasoningSkill         String
  difficulty             String
  skillEmphasis          String?
  defaultTimeMode        String                         @default("untimed")
  defaultDurationMinutes Int
  provenanceUrl          String?
  archivedAt             DateTime?                      @db.Timestamptz(6)
  sources                ApHistoryPromptLibrarySource[]

  @@index([assignmentTypeId, essayType])
  @@index([course, periodNumber])
  @@index([archivedAt])
}

model ApHistoryPromptLibrarySource {
  id                   String                      @id @default(cuid())
  createdAt            DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)
  externalKey          String                      @unique
  promptLibraryEntryId String
  promptLibraryEntry   ApHistoryPromptLibraryEntry @relation(fields: [promptLibraryEntryId], references: [id], onDelete: Cascade)
  position             Int
  title                String
  attribution          String
  body                 String
  caption              String?
  mediaType            String                      @default("text")
  imageUrl             String?
  imageAlt             String?
  provenanceUrl        String?

  @@index([promptLibraryEntryId, position])
}

model AssignmentTypeImage {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @db.Timestamptz(6)
  altText          String?
  contentType      String
  blob             Bytes
  assignmentTypeId String         @unique
  assignmentType   AssignmentType @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
}

model AssignmentModule {
  id                  String                        @id @default(cuid())
  createdAt           DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                      @default(now()) @db.Timestamptz(6)
  deletedAt           DateTime?                     @db.Timestamptz(6)
  title               String
  position            Int
  description         String?
  tutorInstructions   String?
  isSelfGuided        Boolean                       @default(false)
  rubricAlignmentJson Json?
  assignmentTypeId    String
  assignmentType      AssignmentType                @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
  instructions        AssignmentModuleInstruction[]
  sessions            AssignmentModuleSession[]
}

model AssignmentModuleInstruction {
  id                 String                              @id @default(cuid())
  createdAt          DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                            @default(now()) @db.Timestamptz(6)
  position           Int
  title              String
  prompt             String
  tutorInstructions  String?
  showChatButton     Boolean?                            @default(false)
  showNextButton     Boolean?                            @default(true)
  assignmentModuleId String
  assignmentModule   AssignmentModule                    @relation(fields: [assignmentModuleId], references: [id], onDelete: Cascade)
  buttons            AssignmentModuleInstructionButton[]
}

model AssignmentModuleInstructionButton {
  id                            String                      @id @default(cuid())
  createdAt                     DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime                    @default(now()) @db.Timestamptz(6)
  position                      Int
  label                         String
  action                        String // 'advance' or 'response'
  assignmentModuleInstructionId String
  assignmentModuleInstruction   AssignmentModuleInstruction @relation(fields: [assignmentModuleInstructionId], references: [id], onDelete: Cascade)
}

model AssignmentModuleSession {
  id                    String                           @id @default(cuid())
  createdAt             DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                         @default(now()) @db.Timestamptz(6)
  deletedAt             DateTime?                        @db.Timestamptz(6)
  title                 String                           @default("Untitled")
  instructionsCompleted Int
  assignmentModuleId    String
  assignmentModule      AssignmentModule                 @relation(fields: [assignmentModuleId], references: [id], onDelete: Cascade)
  documentId            String
  document              Document                         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  messages              AssignmentModuleSessionMessage[]
}

model AssignmentModuleSessionMessage {
  id                        String                  @id @default(cuid())
  createdAt                 DateTime                @default(now()) @db.Timestamptz(6)
  instructionId             String
  content                   String
  agent                     String
  factCheckPrompt           String?
  context                   String?
  assignmentModuleSessionId String
  assignmentModuleSession   AssignmentModuleSession @relation(fields: [assignmentModuleSessionId], references: [id], onDelete: Cascade)
}

model Document {
  id                       String                    @id @default(cuid())
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @db.Timestamptz(6)
  revision                 Int                       @default(0)
  deletedAt                DateTime?                 @db.Timestamptz(6)
  archivedAt               DateTime?                 @db.Timestamptz(6)
  title                    String                    @default("Untitled")
  text                     String?
  html                     String?
  membership               OrgMembership             @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipId             String
  assignmentTypeId         String
  assignmentType           AssignmentType            @relation(fields: [assignmentTypeId], references: [id], onDelete: Restrict)
  assignmentId             String?
  assignment               Assignment?               @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  classAssignmentId        String?
  classAssignment          ClassAssignment?          @relation(fields: [classAssignmentId], references: [id], onDelete: SetNull)
  assignmentModuleSessions AssignmentModuleSession[]
  comments                 DocumentComment[]
  writeJournals            DocumentWriteJournal[]
  pasteAlerts              PasteAlert[]
  revisions                DocumentRevision[]
  submissions              Submission[]

  @@index([assignmentId])
  @@index([classAssignmentId])
  @@index([assignmentTypeId])
  @@index([membershipId])
}

model DocumentClassForensic {
  documentId String   @id
  oldClassId String
  capturedAt DateTime @default(now()) @db.Timestamptz(6)
}

model AssignmentModuleSessionStudentForensic {
  sessionId           String   @id
  oldStudentProfileId String
  documentId          String
  capturedAt          DateTime @default(now()) @db.Timestamptz(6)

  @@index([documentId])
  @@index([oldStudentProfileId])
}

model ClassStudentCourseForensic {
  classId         String
  studentCourseId String
  capturedAt      DateTime @default(now()) @db.Timestamptz(6)

  @@id([classId, studentCourseId])
}

model DocumentComment {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now()) @db.Timestamptz(6)
  archivedAt   DateTime?                 @db.Timestamptz(6)
  content      String
  highlightId  String?
  documentId   String
  document     Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  membership   OrgMembership             @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipId String
  responses    DocumentCommentResponse[]
}

model DocumentCommentResponse {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  content         String
  commentId       String
  documentComment DocumentComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  membershipId    String
  membership      OrgMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model DocumentRevision {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  html       String
  text       String
  trigger    String

  @@index([documentId, createdAt(sort: Desc)])
}

model DocumentWriteJournal {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  eventType         String
  source            String
  status            String
  failureReason     String?
  requestId         String?
  traceId           String?
  userId            String?
  membershipId      String?
  sessionId         String?
  editorSessionId   String?
  clientSeq         Int?
  baseRevision      Int?
  resultingRevision Int?
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title             String?
  html              String
  text              String
  htmlHash          String
  textHash          String
  metadata          Json?

  @@index([documentId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([requestId])
  @@index([traceId])
  @@index([editorSessionId, clientSeq(sort: Desc)])
}

model Organization {
  id                         String                       @id @default(cuid())
  createdAt                  DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                     @default(now()) @db.Timestamptz(6)
  name                       String
  accessExpiresAt            DateTime?                    @db.Timestamptz(6)
  numOfStudentSeats          Int                          @default(10)
  numOfTeacherSeats          Int                          @default(10)
  reporterEnabled            Boolean                      @default(false)
  writingFundamentalsEnabled Boolean                      @default(false)
  compositionDrillsEnabled   Boolean                      @default(false)
  classInsightsEnabled       Boolean                      @default(false)
  ltiEnabled                 Boolean                      @default(false)
  memberships                OrgMembership[]
  invitations                Invitation[]
  schools                    School[]
  assignmentTypes            AssignmentType[]
  assignmentTypeAssignments  OrganizationAssignmentType[]
  reporterConversations      ReporterConversation[]
  reporterGrowthPlans        ReporterGrowthPlan[]
  aiRequestReservations      AiRequestReservation[]
  writingPracticeAssignments WritingPracticeAssignment[]
  ltiRegistrations           LtiRegistration[]
  ltiLaunchTransactions      LtiLaunchTransaction[]
  ltiPendingLinks            LtiPendingLink[]
  ltiExternalIdentities      LtiExternalIdentity[]
  ltiCourseMappings          LtiCourseMapping[]
  ltiAuditEvents             LtiAuditEvent[]
  ltiDeepLinkRequests        LtiDeepLinkRequest[]
  ltiPlacements              LtiPlacement[]
  ltiRosterEnrollments       LtiRosterEnrollment[]
  ltiWorkflowRuns            LtiWorkflowRun[]
  ltiGradePassbacks          LtiGradePassback[]
}

model LtiRegistration {
  id                    String                 @id @default(cuid())
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(6)
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider              String
  displayName           String
  issuer                String
  clientId              String
  deploymentId          String
  authorizationEndpoint String
  tokenEndpoint         String
  jwksUrl               String
  loginInitiationUrl    String
  launchUrl             String
  deepLinkingLaunchUrl  String
  toolJwksUrl           String
  allowedAudiences      String[]
  allowedServiceOrigins String[]
  allowedTargetLinkUris String[]
  enabledScopes         String[]
  jwksCacheTtlSeconds   Int                    @default(300)
  enabled               Boolean                @default(false)
  disabledAt            DateTime?              @db.Timestamptz(6)
  uninstalledAt         DateTime?              @db.Timestamptz(6)
  launchTransactions    LtiLaunchTransaction[]
  pendingLinks          LtiPendingLink[]
  externalIdentities    LtiExternalIdentity[]
  courseMappings        LtiCourseMapping[]
  auditEvents           LtiAuditEvent[]
  sessions              Session[]              @relation("LtiRegistrationSessions")
  deepLinkRequests      LtiDeepLinkRequest[]
  placements            LtiPlacement[]
  rosterEnrollments     LtiRosterEnrollment[]
  workflowRuns          LtiWorkflowRun[]
  gradePassbacks        LtiGradePassback[]

  @@unique([issuer, clientId, deploymentId])
  @@unique([id, organizationId])
  @@index([organizationId, enabled])
}

model LtiLaunchTransaction {
  id                   String              @id @default(cuid())
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  expiresAt            DateTime            @db.Timestamptz(6)
  consumedAt           DateTime?           @db.Timestamptz(6)
  stateHash            String              @unique
  nonceHash            String              @unique
  browserBindingHash   String              @unique
  requesterHash        String
  verificationAttempts Int                 @default(0)
  loginHintHash        String
  messageHintHash      String?
  targetLinkUri        String
  expectedMessageType  String
  registrationId       String
  organizationId       String
  registration         LtiRegistration     @relation(fields: [registrationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pendingLink          LtiPendingLink?
  deepLinkRequest      LtiDeepLinkRequest?

  @@index([registrationId, expiresAt])
  @@index([organizationId, consumedAt])
  @@index([requesterHash, createdAt(sort: Desc)])
}

model LtiPendingLink {
  id               String               @id @default(cuid())
  createdAt        DateTime             @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime             @db.Timestamptz(6)
  consumedAt       DateTime?            @db.Timestamptz(6)
  secretHash       String               @unique
  subjectHash      String
  subjectHashKeyId String
  membershipRole   MembershipRole
  transactionId    String               @unique
  registrationId   String
  organizationId   String
  courseMappingId  String
  transaction      LtiLaunchTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  registration     LtiRegistration      @relation(fields: [registrationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseMapping    LtiCourseMapping     @relation(fields: [courseMappingId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([registrationId, subjectHash])
  @@index([organizationId, expiresAt])
}

model LtiExternalIdentity {
  id                String                @id @default(cuid())
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(6)
  lastLaunchedAt    DateTime?             @db.Timestamptz(6)
  subjectHash       String
  subjectHashKeyId  String
  registrationId    String
  organizationId    String
  membershipId      String
  registration      LtiRegistration       @relation(fields: [registrationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership        OrgMembership         @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sessions          Session[]             @relation("LtiIdentitySessions")
  rosterEnrollments LtiRosterEnrollment[]
  gradePassbacks    LtiGradePassback[]

  @@unique([registrationId, subjectHash])
  @@unique([registrationId, membershipId])
  @@unique([id, organizationId])
  @@index([organizationId, membershipId])
}

model LtiCourseMapping {
  id                  String                @id @default(cuid())
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(6)
  contextId           String
  enabled             Boolean               @default(true)
  registrationId      String
  organizationId      String
  classId             String
  nrpsMembershipsUrl  String?
  nrpsVersions        String[]              @default([])
  agsLineItemsUrl     String?
  agsScopes           String[]              @default([])
  lastServiceLaunchAt DateTime?             @db.Timestamptz(6)
  registration        LtiRegistration       @relation(fields: [registrationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class               Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  pendingLinks        LtiPendingLink[]
  deepLinkRequests    LtiDeepLinkRequest[]
  placements          LtiPlacement[]
  rosterEnrollments   LtiRosterEnrollment[]
  workflowRuns        LtiWorkflowRun[]
  gradePassbacks      LtiGradePassback[]

  @@unique([registrationId, contextId])
  @@unique([registrationId, classId])
  @@unique([id, organizationId])
  @@index([organizationId, enabled])
  @@index([classId])
}

model LtiDeepLinkRequest {
  id                  String               @id @default(cuid())
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  expiresAt           DateTime             @db.Timestamptz(6)
  consumedAt          DateTime?            @db.Timestamptz(6)
  browserSecretHash   String               @unique
  responseNonce       String
  returnUrl           String
  data                String?
  acceptTypes         String[]
  documentTargets     String[]
  acceptsMultiple     Boolean
  acceptLineItem      Boolean?
  transactionId       String               @unique
  registrationId      String
  organizationId      String
  courseMappingId     String
  teacherMembershipId String
  transaction         LtiLaunchTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  registration        LtiRegistration      @relation(fields: [registrationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseMapping       LtiCourseMapping     @relation(fields: [courseMappingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  teacherMembership   OrgMembership        @relation(fields: [teacherMembershipId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@index([courseMappingId, consumedAt])
}

model LtiPlacement {
  id                String             @id @default(cuid())
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  resourceId        String
  resourceLinkId    String?
  lineItemUrl       String?
  scoreMaximum      Float
  enabled           Boolean            @default(true)
  registrationId    String
  organizationId    String
  courseMappingId   String
  classAssignmentId String
  registration      LtiRegistration    @relation(fields: [registrationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseMapping     LtiCourseMapping   @relation(fields: [courseMappingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  classAssignment   ClassAssignment    @relation(fields: [classAssignmentId], references: [id], onDelete: Cascade)
  gradePassbacks    LtiGradePassback[]

  @@unique([registrationId, resourceId])
  @@unique([registrationId, resourceLinkId])
  @@unique([courseMappingId, classAssignmentId])
  @@unique([id, organizationId])
  @@index([organizationId, enabled])
}

model LtiRosterEnrollment {
  id                  String               @id @default(cuid())
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  subjectHash         String
  subjectHashKeyId    String
  role                MembershipRole
  lmsStatus           String
  reconciliationState String
  managedByLti        Boolean              @default(false)
  lastSeenAt          DateTime             @db.Timestamptz(6)
  registrationId      String
  organizationId      String
  courseMappingId     String
  externalIdentityId  String?
  membershipId        String?
  registration        LtiRegistration      @relation(fields: [registrationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseMapping       LtiCourseMapping     @relation(fields: [courseMappingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  externalIdentity    LtiExternalIdentity? @relation(fields: [externalIdentityId, organizationId], references: [id, organizationId], onDelete: Cascade)
  membership          OrgMembership?       @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([courseMappingId, subjectHash])
  @@index([organizationId, reconciliationState])
  @@index([membershipId, courseMappingId])
}

model LtiWorkflowRun {
  id              String           @id @default(cuid())
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  completedAt     DateTime?        @db.Timestamptz(6)
  nextAttemptAt   DateTime?        @db.Timestamptz(6)
  deadLetteredAt  DateTime?        @db.Timestamptz(6)
  kind            String
  status          String
  idempotencyKey  String
  attemptCount    Int              @default(0)
  errorCode       String?
  summary         Json?
  registrationId  String
  organizationId  String
  courseMappingId String
  registration    LtiRegistration  @relation(fields: [registrationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseMapping   LtiCourseMapping @relation(fields: [courseMappingId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([registrationId, idempotencyKey])
  @@index([organizationId, kind, createdAt(sort: Desc)])
  @@index([status, nextAttemptAt])
}

