/// A teacher-authored writing-practice assignment (the template/config).
/// One lesson slug = massed practice on a single skill; multiple slugs =
/// interleaved practice mixing skills.
model WritingPracticeAssignment {
  id                    String                           @id @default(cuid())
  createdAt             DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                         @default(now()) @updatedAt @db.Timestamptz(6)
  title                 String?
  lessonSlugs           String[]
  /// How many practice prompts each student should complete.
  problemCount          Int                              @default(5)
  dueAt                 DateTime?                        @db.Timestamptz(6)
  instructions          String?
  organizationId        String
  organization          Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByMembershipId String?
  createdByMembership   OrgMembership?                   @relation("WritingPracticeAssignmentCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  classAssignments      WritingPracticeClassAssignment[]

  @@index([createdByMembershipId])
  @@index([organizationId])
}

/// Per-class deployment of a writing-practice assignment (the join row),
/// mirroring the Assignment -> ClassAssignment split.
model WritingPracticeClassAssignment {
  id           String                     @id @default(cuid())
  createdAt    DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)
  assignmentId String
  assignment   WritingPracticeAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  classId      String
  class        Class                      @relation(fields: [classId], references: [id], onDelete: Cascade)
  attempts     WritingPracticeAttempt[]
  promptSets   WritingPracticePromptSet[]

  @@unique([assignmentId, classId])
  @@index([classId, createdAt(sort: Desc)])
}

/// A single student's persisted response to one practice prompt, with the
/// tutor feedback it produced. Snapshots the prompt text so history survives
/// lesson-content changes.
model WritingPracticeAttempt {
  id                   String                         @id @default(cuid())
  createdAt            DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                       @default(now()) @updatedAt @db.Timestamptz(6)
  classAssignmentId    String
  classAssignment      WritingPracticeClassAssignment @relation(fields: [classAssignmentId], references: [id], onDelete: Cascade)
  membershipId         String
  membership           OrgMembership                  @relation("WritingPracticeAttemptStudent", fields: [membershipId], references: [id], onDelete: Cascade)
  /// Immutable 1-based position in this student's stored assignment sequence.
  position             Int
  /// ACT remains revision 1; Composition creates an append-only revision trail.
  revision             Int                            @default(1)
  /// SHA-256 of a normalized Composition response for network-retry idempotency.
  responseDigest       String?
  /// False only for quarantined legacy replays that must not inflate progress.
  countsTowardProgress Boolean                        @default(true)
  lessonSlug           String
  promptId             String
  exercise             String
  instruction          String
  response             String
  /// Feedback status: 'strong' | 'developing' | 'needs_revision'.
  status               String
  feedbackJson         Json

  @@unique([classAssignmentId, membershipId, position, revision], map: "writing_attempt_position_revision_uq")
  @@unique([classAssignmentId, membershipId, position, responseDigest], map: "writing_attempt_position_digest_uq")
  @@index([classAssignmentId, membershipId, createdAt(sort: Desc)])
  @@index([membershipId, createdAt(sort: Desc)])
}

/// A student's generated (or static-fallback) practice sequence for one
/// assignment. Stored so their prompts stay stable across reloads and can be a
/// much larger, non-repeating set than the archived prompt bank.
model WritingPracticePromptSet {
  id                String                         @id @default(cuid())
  createdAt         DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                       @default(now()) @updatedAt @db.Timestamptz(6)
  classAssignmentId String
  classAssignment   WritingPracticeClassAssignment @relation(fields: [classAssignmentId], references: [id], onDelete: Cascade)
  membershipId      String
  membership        OrgMembership                  @relation("WritingPracticePromptSetStudent", fields: [membershipId], references: [id], onDelete: Cascade)
  /// 'ai' when generated by the model, 'static' when the archived bank was used.
  source            String
  promptsJson       Json

  @@unique([classAssignmentId, membershipId])
}
