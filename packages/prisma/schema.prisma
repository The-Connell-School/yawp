generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Class {
  id          String           @id @default(cuid())
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @db.Timestamptz(6)
  code        String
  schoolYear  String           @default("2024-2025")
  period      String
  grade       String
  title       String?
  isArchived  Boolean          @default(false)
  students    StudentProfile[]
  teachers    TeacherProfile[]
  schoolId    String
  school      School           @relation(fields: [schoolId], references: [id])
  assignments Assignment[]

  @@unique([schoolId, code])
  @@index([schoolId, schoolYear, period, grade])
}

model AssignmentType {
  id                      String                       @id @default(cuid())
  createdAt               DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                     @default(now()) @db.Timestamptz(6)
  title                   String
  description             String?
  position                Int
  archivedAt              DateTime?                    @db.Timestamptz(6)
  ownerOrgId              String?
  ownerOrg                Organization?                @relation(fields: [ownerOrgId], references: [id], onDelete: Cascade)
  ownerTeacherId          String?
  ownerTeacher            Profile?                     @relation("AssignmentTypeOwner", fields: [ownerTeacherId], references: [id], onDelete: Cascade)
  image                   AssignmentTypeImage?
  organizationAssignments OrganizationAssignmentType[]
  assignmentModules       AssignmentModule[]
  assignments             Assignment[]
  documents               Document[]

  @@index([ownerOrgId])
  @@index([ownerTeacherId])
  @@index([archivedAt])
}

model Assignment {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @db.Timestamptz(6)
  classId          String
  class            Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignmentTypeId String
  assignmentType   AssignmentType @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
  title            String?
  prompt           String
  tutorContext     String?
  dueDate          DateTime?      @db.Timestamptz(6)
  documents        Document[]

  @@index([classId, createdAt(sort: Desc)])
  @@index([assignmentTypeId])
  @@index([dueDate])
}

model AssignmentTypeImage {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @db.Timestamptz(6)
  altText          String?
  contentType      String
  blob             Bytes
  assignmentTypeId String         @unique
  assignmentType   AssignmentType @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
}

model AssignmentModule {
  id                String                        @id @default(cuid())
  createdAt         DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                      @default(now()) @db.Timestamptz(6)
  deletedAt         DateTime?                     @db.Timestamptz(6)
  title             String
  position          Int
  description       String?
  tutorInstructions String?
  isSelfGuided      Boolean                       @default(false)
  assignmentTypeId  String
  assignmentType    AssignmentType                @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
  instructions      AssignmentModuleInstruction[]
  sessions          AssignmentModuleSession[]
}

model AssignmentModuleInstruction {
  id                 String                              @id @default(cuid())
  createdAt          DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                            @default(now()) @db.Timestamptz(6)
  position           Int
  title              String
  prompt             String
  tutorInstructions  String?
  showChatButton     Boolean?                            @default(false)
  showNextButton     Boolean?                            @default(true)
  assignmentModuleId String
  assignmentModule   AssignmentModule                    @relation(fields: [assignmentModuleId], references: [id], onDelete: Cascade)
  buttons            AssignmentModuleInstructionButton[]
}

model AssignmentModuleInstructionButton {
  id                            String                      @id @default(cuid())
  createdAt                     DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime                    @default(now()) @db.Timestamptz(6)
  position                      Int
  label                         String
  action                        String // 'advance' or 'response'
  assignmentModuleInstructionId String
  assignmentModuleInstruction   AssignmentModuleInstruction @relation(fields: [assignmentModuleInstructionId], references: [id], onDelete: Cascade)
}

model AssignmentModuleSession {
  id                    String                           @id @default(cuid())
  createdAt             DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                         @default(now()) @db.Timestamptz(6)
  deletedAt             DateTime?                        @db.Timestamptz(6)
  title                 String                           @default("Untitled")
  instructionsCompleted Int
  assignmentModuleId    String
  assignmentModule      AssignmentModule                 @relation(fields: [assignmentModuleId], references: [id], onDelete: Cascade)
  documentId            String
  document              Document                         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  messages              AssignmentModuleSessionMessage[]
}

model AssignmentModuleSessionMessage {
  id                        String                  @id @default(cuid())
  createdAt                 DateTime                @default(now()) @db.Timestamptz(6)
  instructionId             String
  content                   String
  agent                     String
  factCheckPrompt           String?
  context                   String?
  assignmentModuleSessionId String
  assignmentModuleSession   AssignmentModuleSession @relation(fields: [assignmentModuleSessionId], references: [id], onDelete: Cascade)
}

model Document {
  id                       String                    @id @default(cuid())
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @db.Timestamptz(6)
  revision                 Int                       @default(0)
  deletedAt                DateTime?                 @db.Timestamptz(6)
  archivedAt               DateTime?                 @db.Timestamptz(6)
  title                    String                    @default("Untitled")
  text                     String?
  html                     String?
  profile                  Profile                   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId                String
  studentProfileId         String
  studentProfile           StudentProfile            @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  assignmentTypeId         String
  assignmentType           AssignmentType            @relation(fields: [assignmentTypeId], references: [id], onDelete: Restrict)
  assignmentId             String?
  assignment               Assignment?               @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  assignmentModuleSessions AssignmentModuleSession[]
  comments                 DocumentComment[]
  writeJournals            DocumentWriteJournal[]
  pasteAlerts              PasteAlert[]
  revisions                DocumentRevision[]
  submissions              Submission[]

  @@index([assignmentId])
  @@index([assignmentTypeId])
  @@index([studentProfileId])
}

model DocumentClassForensic {
  documentId String   @id
  oldClassId String
  capturedAt DateTime @default(now()) @db.Timestamptz(6)
}

model AssignmentModuleSessionStudentForensic {
  sessionId           String   @id
  oldStudentProfileId String
  documentId          String
  capturedAt          DateTime @default(now()) @db.Timestamptz(6)

  @@index([documentId])
  @@index([oldStudentProfileId])
}

model ClassStudentCourseForensic {
  classId         String
  studentCourseId String
  capturedAt      DateTime @default(now()) @db.Timestamptz(6)

  @@id([classId, studentCourseId])
}

model DocumentComment {
  id          String                    @id @default(cuid())
  createdAt   DateTime                  @default(now()) @db.Timestamptz(6)
  archivedAt  DateTime?                 @db.Timestamptz(6)
  content     String
  highlightId String?
  documentId  String
  document    Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  profile     Profile                   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  responses   DocumentCommentResponse[]
}

model DocumentCommentResponse {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  content         String
  commentId       String
  documentComment DocumentComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profileId       String
  profile         Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model DocumentRevision {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  html       String
  text       String
  trigger    String

  @@index([documentId, createdAt(sort: Desc)])
}

model DocumentWriteJournal {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  eventType         String
  source            String
  status            String
  failureReason     String?
  requestId         String?
  traceId           String?
  userId            String?
  profileId         String?
  sessionId         String?
  editorSessionId   String?
  clientSeq         Int?
  baseRevision      Int?
  resultingRevision Int?
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title             String?
  html              String
  text              String
  htmlHash          String
  textHash          String
  metadata          Json?

  @@index([documentId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([requestId])
  @@index([traceId])
  @@index([editorSessionId, clientSeq(sort: Desc)])
}

model Organization {
  id                        String                       @id @default(cuid())
  createdAt                 DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                     @default(now()) @db.Timestamptz(6)
  name                      String
  accessExpiresAt           DateTime?                    @db.Timestamptz(6)
  numOfStudentSeats         Int                          @default(10)
  numOfTeacherSeats         Int                          @default(10)
  profiles                  Profile[]
  invitations               Invitation[]
  schools                   School[]
  assignmentTypes           AssignmentType[]
  assignmentTypeAssignments OrganizationAssignmentType[]
}

model OrganizationAssignmentType {
  organizationId   String
  assignmentTypeId String
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignmentType   AssignmentType @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)

  @@id([organizationId, assignmentTypeId])
  @@index([assignmentTypeId])
}

model Profile {
  id                       String                    @id @default(cuid())
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  organizationId           String
  organization             Organization              @relation(fields: [organizationId], references: [id])
  userId                   String
  user                     User                      @relation(fields: [userId], references: [id])
  documents                Document[]
  documentComments         DocumentComment[]
  documentCommentResponses DocumentCommentResponse[]
  pasteAlerts              PasteAlert[]
  submissionsGraded        Submission[]              @relation("SubmissionGradedBy")
  submissionComments       SubmissionComment[]       @relation("SubmissionCommentProfile")
  studentProfile           StudentProfile?
  teacherProfile           TeacherProfile?
  ownedAssignmentTypes     AssignmentType[]          @relation("AssignmentTypeOwner")
  isOwner                  Boolean                   @default(false)
}

model Password {
  hash   String
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model School {
  id             String           @id @default(cuid())
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @db.Timestamptz(6)
  name           String
  code           String           @unique
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  classes        Class[]
  teachers       TeacherProfile[]
  invitations    Invitation[]
}

model Session {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)
  expirationDate DateTime @default(now()) @db.Timestamptz(6)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  name        String   @unique
  description String?
  value       String
  valueType   String   @default("string")
}

model FeatureAccessTarget {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @db.Timestamptz(6)
  featureKey String
  targetKind String
  targetId   String
  enabled    Boolean   @default(true)
  expiresAt  DateTime? @db.Timestamptz(6)
  note       String?

  @@unique([featureKey, targetKind, targetId])
  @@index([targetKind, targetId])
  @@index([featureKey, enabled])
  @@index([expiresAt])
}

model StudentProfile {
  id            String     @id @default(cuid())
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  school        String?
  schoolTeacher String?
  grade         String?
  period        String?
  profileId     String     @unique
  profile       Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  classes       Class[]
  documents     Document[]
}

model TeacherProfile {
  id                            String                         @id @default(cuid())
  createdAt                     DateTime                       @default(now()) @db.Timestamptz(6)
  isActive                      Boolean                        @default(true)
  profileId                     String                         @unique
  profile                       Profile                        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  teacherTrainingModuleSessions TeacherTrainingModuleSession[]
  assignedTeacherTrainings      TeacherTraining[]              @relation("TeacherTrainingAssignments")
  classes                       Class[]
  schools                       School[]
}

// Upload table removed. Videos will be stored in S3 and referenced by key.

model User {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @db.Timestamptz(6)
  email     String    @unique
  name      String?
  password  Password?
  sessions  Session[]
  profiles  Profile[]
  isAdmin   Boolean   @default(false)
}

model Invitation {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  type           String
  target         String
  secret         String
  algorithm      String
  digits         Int
  period         Int
  charSet        String
  expiresAt      DateTime?     @db.Timestamptz(6)
  metadata       String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolId       String?
  school         School?       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([target, type])
}

model TeacherTraining {
  id                     String                    @id @default(cuid())
  createdAt              DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                  @default(now()) @db.Timestamptz(6)
  title                  String
  description            String?
  position               Int
  image                  TeacherTrainingImage?
  teacherTrainingModules TeacherTrainingModule[]
  resources              TeacherTrainingResource[]
  assignedTeachers       TeacherProfile[]          @relation("TeacherTrainingAssignments")
}

model TeacherTrainingImage {
  id                String          @id @default(cuid())
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @db.Timestamptz(6)
  altText           String?
  contentType       String
  blob              Bytes
  teacherTrainingId String          @unique
  teacherTraining   TeacherTraining @relation(fields: [teacherTrainingId], references: [id], onDelete: Cascade)
}

model TeacherTrainingModule {
  id                            String                          @id @default(cuid())
  createdAt                     DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime                        @default(now()) @db.Timestamptz(6)
  deletedAt                     DateTime?                       @db.Timestamptz(6)
  title                         String
  position                      Int
  description                   String?
  videoS3Key                    String? /// S3 object key for the module video. Playback will use signed URLs derived from this.
  videoDuration                 Int? // Duration in seconds
  teacherTrainingId             String?
  teacherTraining               TeacherTraining?                @relation(fields: [teacherTrainingId], references: [id], onDelete: Cascade)
  resources                     TeacherTrainingModuleResource[]
  teacherTrainingModuleSessions TeacherTrainingModuleSession[]
}

model TeacherTrainingModuleResource {
  id                      String                @id @default(cuid())
  createdAt               DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime              @default(now()) @db.Timestamptz(6)
  name                    String
  contentType             String
  blob                    Bytes
  teacherTrainingModuleId String
  teacherTrainingModule   TeacherTrainingModule @relation(fields: [teacherTrainingModuleId], references: [id], onDelete: Cascade)
}

model TeacherTrainingResource {
  id                String          @id @default(cuid())
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @db.Timestamptz(6)
  title             String
  description       String?
  url               String?
  teacherTrainingId String
  teacherTraining   TeacherTraining @relation(fields: [teacherTrainingId], references: [id], onDelete: Cascade)
}

model TeacherTrainingModuleSession {
  id                      String                @id @default(cuid())
  createdAt               DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime              @default(now()) @db.Timestamptz(6)
  deletedAt               DateTime?             @db.Timestamptz(6)
  videoTimestamp          Int                   @default(0) // Last watched timestamp in seconds
  teacherTrainingModuleId String
  teacherProfileId        String
  teacherTrainingModule   TeacherTrainingModule @relation(fields: [teacherTrainingModuleId], references: [id], onDelete: Cascade)
  teacherProfile          TeacherProfile        @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([teacherTrainingModuleId, teacherProfileId])
}

model PasteAlert {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  textLength Int
  content    String?
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt(sort: Desc)])
  @@index([profileId, createdAt(sort: Desc)])
}

model Submission {
  id                String              @id @default(cuid())
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @db.Timestamptz(6)
  title             String
  text              String
  html              String
  submittedAt       DateTime            @db.Timestamptz(6)
  score             String?
  feedback          String?
  rubricScores      Json?
  overallScore      Int?
  overallComment    String?
  numericPercentage Int?
  letterGrade       String?
  grammarIssues     Json?
  promptConfig      Json?
  aiMeta            Json?
  gradedAt          DateTime?           @db.Timestamptz(6)
  gradedById        String?
  gradedBy          Profile?            @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)
  releasedAt        DateTime?           @db.Timestamptz(6)
  /// When set, hidden from the student's active submission list (teachers unaffected).
  archivedAt        DateTime?           @db.Timestamptz(6)
  documentId        String
  document          Document            @relation(fields: [documentId], references: [id], onDelete: Restrict)
  comments          SubmissionComment[]

  @@index([documentId, submittedAt(sort: Desc)])
  @@index([documentId, archivedAt])
  @@index([gradedById])
  @@index([releasedAt])
}

model SubmissionComment {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @db.Timestamptz(6)
  content      String
  excerpt      String?
  occurrence   Int        @default(1)
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  profileId    String
  profile      Profile    @relation("SubmissionCommentProfile", fields: [profileId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt(sort: Desc)])
  @@index([profileId])
}

model LegacyGradeRedirect {
  gradeId      String   @id
  submissionId String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
}

model LlmLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  model        String
  provider     String // 'anthropic' or 'openai'
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  durationMs   Int?
  systemPrompt String?
  messages     Json // Input messages
  response     String? // Output text
  error        String? // Error message if failed
  metadata     Json? // Any additional context (e.g., caller info)

  @@index([createdAt(sort: Desc)])
  @@index([model])
  @@index([provider])
}
