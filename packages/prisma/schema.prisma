generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  TEACHER
  STUDENT
}

model Class {
  id               String            @id @default(cuid())
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @db.Timestamptz(6)
  code             String
  schoolYear       String            @default("2024-2025")
  period           String
  grade            String
  title            String?
  cardGradientKey  String            @default("indigo-purple-pink")
  classArtIndex    Int?
  classArtKey      String?
  isArchived       Boolean           @default(false)
  students         OrgMembership[]   @relation("ClassStudents")
  teachers         OrgMembership[]   @relation("ClassTeachers")
  schoolId         String
  school           School            @relation(fields: [schoolId], references: [id])
  classAssignments ClassAssignment[]

  @@unique([schoolId, code])
  @@index([schoolId, schoolYear, period, grade])
}

model AssignmentType {
  id                                 String                        @id @default(cuid())
  createdAt                          DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt                          DateTime                      @default(now()) @db.Timestamptz(6)
  title                              String
  kind                               String?                       @unique
  description                        String?
  position                           Int
  systemKey                          String?                       @unique
  archivedAt                         DateTime?                     @db.Timestamptz(6)
  ownerOrgId                         String?
  ownerOrg                           Organization?                 @relation(fields: [ownerOrgId], references: [id], onDelete: Cascade)
  ownerMembershipId                  String?
  ownerMembership                    OrgMembership?                @relation("AssignmentTypeOwner", fields: [ownerMembershipId], references: [id], onDelete: Cascade)
  scoringScaleJson                   Json?
  rubricJson                         Json?
  gradingPromptConfigJson            Json?
  gradingOutputSchemaJson            Json?
  gradingCalibrationNotes            String?
  gradingAssistantVersion            Int                           @default(1)
  gradingAssistantSourceTemplateId   String?
  gradingAssistantSourceTemplateSlug String?
  image                              AssignmentTypeImage?
  organizationAssignments            OrganizationAssignmentType[]
  schoolAssignments                  SchoolAssignmentType[]
  teacherAssignments                 TeacherAssignmentType[]
  assignmentModules                  AssignmentModule[]
  assignments                        Assignment[]
  documents                          Document[]
  apHistoryLibraryEntries            ApHistoryPromptLibraryEntry[]

  @@index([ownerOrgId])
  @@index([ownerMembershipId])
  @@index([archivedAt])
  @@index([systemKey])
  @@index([kind])
}

model Assignment {
  id                              String            @id @default(cuid())
  createdAt                       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime          @default(now()) @db.Timestamptz(6)
  assignmentTypeId                String
  assignmentType                  AssignmentType    @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
  title                           String?
  prompt                          String
  promptAttachmentKey             String?
  promptAttachmentName            String?
  promptAttachmentSize            Int?
  submitForGrade                  Boolean           @default(true)
  pointValue                      Int?              @default(100)
  gradingAssistantStrictnessLevel String            @default("intermediate")
  apHistorySnapshot               Json?
  classAssignments                ClassAssignment[]
  documents                       Document[]

  @@index([assignmentTypeId])
}

model ClassAssignment {
  id           String                  @id @default(cuid())
  createdAt    DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                @default(now()) @db.Timestamptz(6)
  assignmentId String
  assignment   Assignment              @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  classId      String
  class        Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  documents    Document[]
  insight      ClassAssignmentInsight?
  lessonPlans  LessonPlanConversation[]

  @@unique([assignmentId, classId])
  @@index([classId, createdAt(sort: Desc)])
}

/// Class-wide, assignment-level feedback for the teacher: an AI summary of how
/// the whole class did on one assignment (strengths, gaps, teaching next steps).
/// One cached row per ClassAssignment; regenerated on demand.
model ClassAssignmentInsight {
  id                      String          @id @default(cuid())
  createdAt               DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  classAssignmentId       String          @unique
  classAssignment         ClassAssignment @relation(fields: [classAssignmentId], references: [id], onDelete: Cascade)
  status                  String          @default("ready") // ready | failed
  model                   String?
  submissionCount         Int             @default(0)
  summaryJson             Json?
  generatedByMembershipId String?
  generatedByMembership   OrgMembership?  @relation(fields: [generatedByMembershipId], references: [id], onDelete: SetNull)
  generatedAt             DateTime?       @db.Timestamptz(6)

  @@index([generatedByMembershipId])
}

model ApHistoryPromptLibraryEntry {
  id                     String                         @id @default(cuid())
  createdAt              DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                       @default(now()) @updatedAt @db.Timestamptz(6)
  externalKey            String                         @unique
  assignmentTypeId       String
  assignmentType         AssignmentType                 @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
  course                 String
  essayType              String
  title                  String
  prompt                 String
  period                 String
  periodNumber           Int
  reasoningSkill         String
  difficulty             String
  skillEmphasis          String?
  defaultTimeMode        String                         @default("untimed")
  defaultDurationMinutes Int
  provenanceUrl          String?
  archivedAt             DateTime?                      @db.Timestamptz(6)
  sources                ApHistoryPromptLibrarySource[]

  @@index([assignmentTypeId, essayType])
  @@index([course, periodNumber])
  @@index([archivedAt])
}

model ApHistoryPromptLibrarySource {
  id                   String                      @id @default(cuid())
  createdAt            DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)
  externalKey          String                      @unique
  promptLibraryEntryId String
  promptLibraryEntry   ApHistoryPromptLibraryEntry @relation(fields: [promptLibraryEntryId], references: [id], onDelete: Cascade)
  position             Int
  title                String
  attribution          String
  body                 String
  caption              String?
  mediaType            String                      @default("text")
  imageUrl             String?
  imageAlt             String?
  provenanceUrl        String?

  @@index([promptLibraryEntryId, position])
}

model AssignmentTypeImage {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @db.Timestamptz(6)
  altText          String?
  contentType      String
  blob             Bytes
  assignmentTypeId String         @unique
  assignmentType   AssignmentType @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
}

model AssignmentModule {
  id                  String                        @id @default(cuid())
  createdAt           DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                      @default(now()) @db.Timestamptz(6)
  deletedAt           DateTime?                     @db.Timestamptz(6)
  title               String
  position            Int
  description         String?
  tutorInstructions   String?
  isSelfGuided        Boolean                       @default(false)
  rubricAlignmentJson Json?
  assignmentTypeId    String
  assignmentType      AssignmentType                @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
  instructions        AssignmentModuleInstruction[]
  sessions            AssignmentModuleSession[]
}

model AssignmentModuleInstruction {
  id                 String                              @id @default(cuid())
  createdAt          DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                            @default(now()) @db.Timestamptz(6)
  position           Int
  title              String
  prompt             String
  tutorInstructions  String?
  showChatButton     Boolean?                            @default(false)
  showNextButton     Boolean?                            @default(true)
  assignmentModuleId String
  assignmentModule   AssignmentModule                    @relation(fields: [assignmentModuleId], references: [id], onDelete: Cascade)
  buttons            AssignmentModuleInstructionButton[]
}

model AssignmentModuleInstructionButton {
  id                            String                      @id @default(cuid())
  createdAt                     DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime                    @default(now()) @db.Timestamptz(6)
  position                      Int
  label                         String
  action                        String // 'advance' or 'response'
  assignmentModuleInstructionId String
  assignmentModuleInstruction   AssignmentModuleInstruction @relation(fields: [assignmentModuleInstructionId], references: [id], onDelete: Cascade)
}

model AssignmentModuleSession {
  id                    String                           @id @default(cuid())
  createdAt             DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                         @default(now()) @db.Timestamptz(6)
  deletedAt             DateTime?                        @db.Timestamptz(6)
  title                 String                           @default("Untitled")
  instructionsCompleted Int
  assignmentModuleId    String
  assignmentModule      AssignmentModule                 @relation(fields: [assignmentModuleId], references: [id], onDelete: Cascade)
  documentId            String
  document              Document                         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  messages              AssignmentModuleSessionMessage[]
}

model AssignmentModuleSessionMessage {
  id                        String                  @id @default(cuid())
  createdAt                 DateTime                @default(now()) @db.Timestamptz(6)
  instructionId             String
  content                   String
  agent                     String
  factCheckPrompt           String?
  context                   String?
  assignmentModuleSessionId String
  assignmentModuleSession   AssignmentModuleSession @relation(fields: [assignmentModuleSessionId], references: [id], onDelete: Cascade)
}

model Document {
  id                       String                    @id @default(cuid())
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @db.Timestamptz(6)
  revision                 Int                       @default(0)
  deletedAt                DateTime?                 @db.Timestamptz(6)
  archivedAt               DateTime?                 @db.Timestamptz(6)
  title                    String                    @default("Untitled")
  text                     String?
  html                     String?
  membership               OrgMembership             @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipId             String
  assignmentTypeId         String
  assignmentType           AssignmentType            @relation(fields: [assignmentTypeId], references: [id], onDelete: Restrict)
  assignmentId             String?
  assignment               Assignment?               @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  classAssignmentId        String?
  classAssignment          ClassAssignment?          @relation(fields: [classAssignmentId], references: [id], onDelete: SetNull)
  assignmentModuleSessions AssignmentModuleSession[]
  comments                 DocumentComment[]
  writeJournals            DocumentWriteJournal[]
  pasteAlerts              PasteAlert[]
  revisions                DocumentRevision[]
  submissions              Submission[]

  @@index([assignmentId])
  @@index([classAssignmentId])
  @@index([assignmentTypeId])
  @@index([membershipId])
}

model DocumentClassForensic {
  documentId String   @id
  oldClassId String
  capturedAt DateTime @default(now()) @db.Timestamptz(6)
}

model AssignmentModuleSessionStudentForensic {
  sessionId           String   @id
  oldStudentProfileId String
  documentId          String
  capturedAt          DateTime @default(now()) @db.Timestamptz(6)

  @@index([documentId])
  @@index([oldStudentProfileId])
}

model ClassStudentCourseForensic {
  classId         String
  studentCourseId String
  capturedAt      DateTime @default(now()) @db.Timestamptz(6)

  @@id([classId, studentCourseId])
}

model DocumentComment {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now()) @db.Timestamptz(6)
  archivedAt   DateTime?                 @db.Timestamptz(6)
  content      String
  highlightId  String?
  documentId   String
  document     Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  membership   OrgMembership             @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipId String
  responses    DocumentCommentResponse[]
}

model DocumentCommentResponse {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  content         String
  commentId       String
  documentComment DocumentComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  membershipId    String
  membership      OrgMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model DocumentRevision {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  html       String
  text       String
  trigger    String

  @@index([documentId, createdAt(sort: Desc)])
}

model DocumentWriteJournal {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  eventType         String
  source            String
  status            String
  failureReason     String?
  requestId         String?
  traceId           String?
  userId            String?
  membershipId      String?
  sessionId         String?
  editorSessionId   String?
  clientSeq         Int?
  baseRevision      Int?
  resultingRevision Int?
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title             String?
  html              String
  text              String
  htmlHash          String
  textHash          String
  metadata          Json?

  @@index([documentId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([requestId])
  @@index([traceId])
  @@index([editorSessionId, clientSeq(sort: Desc)])
}

model Organization {
  id                         String                       @id @default(cuid())
  createdAt                  DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                     @default(now()) @db.Timestamptz(6)
  name                       String
  accessExpiresAt            DateTime?                    @db.Timestamptz(6)
  numOfStudentSeats          Int                          @default(10)
  numOfTeacherSeats          Int                          @default(10)
  reporterEnabled            Boolean                      @default(false)
  classInsightsEnabled       Boolean                      @default(false)
  lessonPlannerEnabled       Boolean                      @default(false)
  memberships                OrgMembership[]
  invitations                Invitation[]
  schools                    School[]
  assignmentTypes            AssignmentType[]
  assignmentTypeAssignments  OrganizationAssignmentType[]
  reporterConversations      ReporterConversation[]
  reporterGrowthPlans        ReporterGrowthPlan[]
  lessonPlanConversations    LessonPlanConversation[]
  aiRequestReservations      AiRequestReservation[]
}

model OrganizationAssignmentType {
  organizationId   String
  assignmentTypeId String
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignmentType   AssignmentType @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)

  @@id([organizationId, assignmentTypeId])
  @@index([assignmentTypeId])
}

model OrgMembership {
  id                            String                         @id @default(cuid())
  createdAt                     DateTime                       @default(now()) @db.Timestamptz(6)
  userId                        String
  user                          User                           @relation(fields: [userId], references: [id])
  organizationId                String
  organization                  Organization                   @relation(fields: [organizationId], references: [id])
  role                          MembershipRole
  isOrgOwner                    Boolean                        @default(false)
  isActive                      Boolean                        @default(true)
  school                        String?
  schoolTeacher                 String?
  grade                         String?
  period                        String?
  documents                     Document[]
  documentComments              DocumentComment[]
  documentCommentResponses      DocumentCommentResponse[]
  pasteAlerts                   PasteAlert[]
  submissionsGraded             Submission[]                   @relation("SubmissionGradedBy")
  submissionComments            SubmissionComment[]            @relation("SubmissionCommentProfile")
  ownedAssignmentTypes          AssignmentType[]               @relation("AssignmentTypeOwner")
  classesAsTeacher              Class[]                        @relation("ClassTeachers")
  classesAsStudent              Class[]                        @relation("ClassStudents")
  schools                       School[]                       @relation("SchoolTeachers")
  teacherTrainingModuleSessions TeacherTrainingModuleSession[]
  assignedTeacherTrainings      TeacherTraining[]              @relation("TeacherTrainingAssignments")
  assignmentTypesCustomized     Boolean                        @default(false)
  assignmentTypeAssignments     TeacherAssignmentType[]
  reporterConversations         ReporterConversation[]
  lessonPlanConversations       LessonPlanConversation[]
  reporterGrowthPlansOwned      ReporterGrowthPlan[]           @relation("ReporterGrowthPlanOwner")
  reporterGrowthPlansAsStudent  ReporterGrowthPlan[]           @relation("ReporterGrowthPlanStudent")
  aiRequestReservations         AiRequestReservation[]

  classAssignmentInsightsGenerated ClassAssignmentInsight[]

  @@unique([userId, organizationId])
  @@unique([id, organizationId])
  @@map("OrgMembership")
}

/// Durable admission record created before an AI provider call. Advisory locks
/// serialize each membership and organization budget so concurrent requests
/// cannot all pass a count-then-call race.
model AiRequestReservation {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  feature        String
  membershipId   String
  membership     OrgMembership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([membershipId, feature, createdAt(sort: Desc)])
  @@index([organizationId, feature, createdAt(sort: Desc)])
}

/// A Yawp Reporter chat session. Owned by a teacher (OrgMembership) and scoped
/// to their organization. Holds an ordered transcript of reporter messages.
model ReporterConversation {
  id             String            @id @default(cuid())
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?         @db.Timestamptz(6)
  title          String            @default("New report")
  membershipId   String
  membership     OrgMembership     @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       ReporterMessage[]

  @@index([membershipId, updatedAt(sort: Desc)])
  @@index([organizationId])
}

/// A single turn in a Yawp Reporter conversation. `role` is 'user' or
/// 'assistant'. `toolCalls` optionally records the tool invocations the
/// assistant made to produce its answer (for transparency/auditing).
model ReporterMessage {
  id             String               @id @default(cuid())
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  role           String
  content        String
  toolCalls      Json?
  conversationId String
  conversation   ReporterConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// A YAWP! Lesson Planner chat session. Owned by a teacher (OrgMembership) and
/// scoped to their organization. Holds an ordered transcript of planner
/// messages. `originClassAssignmentId` records the Class Summary next step the
/// session was opened from, when the teacher came in through that seam.
model LessonPlanConversation {
  id                      String              @id @default(cuid())
  createdAt               DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt               DateTime?           @db.Timestamptz(6)
  title                   String              @default("New lesson")
  membershipId            String
  membership              OrgMembership       @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationId          String
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  originClassAssignmentId String?
  originClassAssignment   ClassAssignment?    @relation(fields: [originClassAssignmentId], references: [id], onDelete: SetNull)
  messages                LessonPlanMessage[]

  @@index([membershipId, updatedAt(sort: Desc)])
  @@index([organizationId])
  @@index([originClassAssignmentId])
}

/// A single turn in a Lesson Planner conversation. `role` is 'user' or
/// 'assistant'. `toolCalls` optionally records the tool invocations the
/// assistant made to produce its answer (for transparency/auditing).
model LessonPlanMessage {
  id             String                 @id @default(cuid())
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  role           String
  content        String
  toolCalls      Json?
  conversationId String
  conversation   LessonPlanConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// A saved, forward-looking writing growth plan for one student, produced by
/// the Yawp Reporter. Owned by a teacher (membership) and scoped to their org.
/// Stores a baseline snapshot at creation so later reports can measure progress
/// on the rubric skills the plan targets. `status` is 'active' | 'archived' |
/// 'completed'; only one plan per student is kept active at a time.
model ReporterGrowthPlan {
  id                  String        @id @default(cuid())
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  status              String        @default("active")
  focus               String
  /// Rubric category keys this plan targets (string[]).
  targetSkills        Json
  body                String
  /// { averagePercentage, rubricLevels: { category: level }, capturedAt } at creation.
  baseline            Json
  checkInAt           DateTime?     @db.Timestamptz(6)
  membershipId        String
  membership          OrgMembership @relation("ReporterGrowthPlanOwner", fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentMembershipId String
  student             OrgMembership @relation("ReporterGrowthPlanStudent", fields: [studentMembershipId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([membershipId, studentMembershipId, status])
  @@index([studentMembershipId])
  @@index([organizationId])
}

model Password {
  hash   String
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model School {
  id                        String                 @id @default(cuid())
  createdAt                 DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime               @default(now()) @db.Timestamptz(6)
  name                      String
  code                      String                 @unique
  organizationId            String
  organization              Organization           @relation(fields: [organizationId], references: [id])
  classes                   Class[]
  teachers                  OrgMembership[]        @relation("SchoolTeachers")
  invitations               Invitation[]
  assignmentTypesCustomized Boolean                @default(false)
  assignmentTypeAssignments SchoolAssignmentType[]
}

model SchoolAssignmentType {
  schoolId         String
  assignmentTypeId String
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentType   AssignmentType @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)

  @@id([schoolId, assignmentTypeId])
  @@index([assignmentTypeId])
}

model TeacherAssignmentType {
  membershipId     String
  assignmentTypeId String
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  membership       OrgMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  assignmentType   AssignmentType @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)

  @@id([membershipId, assignmentTypeId])
  @@index([assignmentTypeId])
}

model Session {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)
  expirationDate DateTime @default(now()) @db.Timestamptz(6)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  name        String   @unique
  description String?
  value       String
  valueType   String   @default("string")
}

// Upload table removed. Videos will be stored in S3 and referenced by key.

model User {
  id           String          @id @default(cuid())
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @db.Timestamptz(6)
  email        String          @unique
  name         String?
  password     Password?
  sessions     Session[]
  memberships  OrgMembership[]
  isAdmin      Boolean         @default(false)
  isSuperAdmin Boolean         @default(false)
}

model Invitation {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  type           String
  target         String
  secret         String
  algorithm      String
  digits         Int
  period         Int
  charSet        String
  expiresAt      DateTime?     @db.Timestamptz(6)
  metadata       String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolId       String?
  school         School?       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([target, type])
}

model TeacherTraining {
  id                     String                    @id @default(cuid())
  createdAt              DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                  @default(now()) @db.Timestamptz(6)
  title                  String
  description            String?
  position               Int
  image                  TeacherTrainingImage?
  teacherTrainingModules TeacherTrainingModule[]
  resources              TeacherTrainingResource[]
  assignedTeachers       OrgMembership[]           @relation("TeacherTrainingAssignments")
}

model TeacherTrainingImage {
  id                String          @id @default(cuid())
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @db.Timestamptz(6)
  altText           String?
  contentType       String
  blob              Bytes
  teacherTrainingId String          @unique
  teacherTraining   TeacherTraining @relation(fields: [teacherTrainingId], references: [id], onDelete: Cascade)
}

model TeacherTrainingModule {
  id                            String                          @id @default(cuid())
  createdAt                     DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime                        @default(now()) @db.Timestamptz(6)
  deletedAt                     DateTime?                       @db.Timestamptz(6)
  title                         String
  position                      Int
  description                   String?
  videoS3Key                    String? /// S3 object key for the module video. Playback will use signed URLs derived from this.
  videoDuration                 Int? // Duration in seconds
  teacherTrainingId             String?
  teacherTraining               TeacherTraining?                @relation(fields: [teacherTrainingId], references: [id], onDelete: Cascade)
  resources                     TeacherTrainingModuleResource[]
  teacherTrainingModuleSessions TeacherTrainingModuleSession[]
}

model TeacherTrainingModuleResource {
  id                      String                @id @default(cuid())
  createdAt               DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime              @default(now()) @db.Timestamptz(6)
  name                    String
  contentType             String
  blob                    Bytes
  teacherTrainingModuleId String
  teacherTrainingModule   TeacherTrainingModule @relation(fields: [teacherTrainingModuleId], references: [id], onDelete: Cascade)
}

model TeacherTrainingResource {
  id                String          @id @default(cuid())
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @db.Timestamptz(6)
  title             String
  description       String?
  url               String?
  teacherTrainingId String
  teacherTraining   TeacherTraining @relation(fields: [teacherTrainingId], references: [id], onDelete: Cascade)
}

model TeacherTrainingModuleSession {
  id                      String                @id @default(cuid())
  createdAt               DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime              @default(now()) @db.Timestamptz(6)
  deletedAt               DateTime?             @db.Timestamptz(6)
  videoTimestamp          Int                   @default(0) // Last watched timestamp in seconds
  teacherTrainingModuleId String
  membershipId            String
  teacherTrainingModule   TeacherTrainingModule @relation(fields: [teacherTrainingModuleId], references: [id], onDelete: Cascade)
  membership              OrgMembership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([teacherTrainingModuleId, membershipId])
}

model PasteAlert {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  textLength   Int
  content      String?
  documentId   String
  document     Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  membershipId String
  membership   OrgMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt(sort: Desc)])
  @@index([membershipId, createdAt(sort: Desc)])
}

model Submission {
  id                   String                          @id @default(cuid())
  createdAt            DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                        @default(now()) @db.Timestamptz(6)
  title                String
  text                 String
  html                 String
  submittedAt          DateTime                        @db.Timestamptz(6)
  score                String?
  feedback             String?
  rubricScores         Json?
  overallScore         Int?
  overallComment       String?
  numericPercentage    Int?
  letterGrade          String?
  grammarIssues        Json?
  promptConfig         Json?
  aiMeta               Json?
  gradedAt             DateTime?                       @db.Timestamptz(6)
  gradedByMembershipId String?
  gradedBy             OrgMembership?                  @relation("SubmissionGradedBy", fields: [gradedByMembershipId], references: [id], onDelete: SetNull)
  releasedAt           DateTime?                       @db.Timestamptz(6)
  /// When set, hidden from the student's active submission list (teachers unaffected).
  archivedAt           DateTime?                       @db.Timestamptz(6)
  documentId           String
  document             Document                        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  comments             SubmissionComment[]
  gradingAssistantRuns SubmissionGradingAssistantRun[]

  @@index([documentId, submittedAt(sort: Desc)])
  @@index([documentId, archivedAt])
  @@index([gradedByMembershipId])
  @@index([releasedAt])
}

model SubmissionGradingAssistantRun {
  id                                 String     @id @default(cuid())
  createdAt                          DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt                          DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  submissionId                       String
  submission                         Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  assignmentTypeId                   String?
  assignmentTypeGradingVersion       Int?
  assignmentTypeRubricSnapshot       Json?
  assignmentTypePromptConfigSnapshot Json?
  source                             String
  model                              String?
  status                             String
  metadata                           Json?

  @@index([submissionId, createdAt(sort: Desc)])
  @@index([assignmentTypeId])
  @@index([status])
}

model SubmissionComment {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @db.Timestamptz(6)
  content      String
  excerpt      String?
  occurrence   Int           @default(1)
  submissionId String
  submission   Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  membershipId String
  membership   OrgMembership @relation("SubmissionCommentProfile", fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt(sort: Desc)])
  @@index([membershipId])
}

model LegacyGradeRedirect {
  gradeId      String   @id
  submissionId String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
}

model LlmLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  model        String
  provider     String // 'anthropic' or 'openai'
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  durationMs   Int?
  systemPrompt String?
  messages     Json // Input messages
  response     String? // Output text
  error        String? // Error message if failed
  metadata     Json? // Any additional context (e.g., caller info)

  @@index([createdAt(sort: Desc)])
  @@index([model])
  @@index([provider])
}
