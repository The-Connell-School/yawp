generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AssistantConfiguration {
  id          String  @id @default(cuid())
  assistantId String  @unique
  pin         String
  actionText  String?
  description String?
}

model AssistantMetadata {
  id          String   @id @default(cuid())
  assistantId String
  isVerified  Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  threads     Thread[]
}

model Connection {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @db.Timestamptz(6)
  providerName String
  providerId   String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerName, providerId])
}

model Course {
  id            String           @id @default(cuid())
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @db.Timestamptz(6)
  title         String
  description   String?
  position      Int
  image         CourseImage?
  courseModules CourseModule[]
  resources     CourseResource[]
}

model CourseImage {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  altText     String?
  contentType String
  blob        Bytes
  courseId    String   @unique
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseModule {
  id                   String                    @id @default(cuid())
  createdAt            DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                  @default(now()) @db.Timestamptz(6)
  deletedAt            DateTime?                 @db.Timestamptz(6)
  title                String
  position             Int
  description          String?
  tutorInstructions    String?
  isSelfGuided         Boolean                   @default(false)
  courseId             String?
  course               Course?                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructions         CourseModuleInstruction[]
  courseModuleSessions CourseModuleSession[]
}

model CourseModuleInstruction {
  id                      String            @id @default(cuid())
  createdAt               DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime          @default(now()) @db.Timestamptz(6)
  courseModuleId          String
  position                Int
  title                   String
  interactiveType         String
  prompt                  String
  tutorInstructions       String?
  answerType              String?
  answerKey               String?
  answerTypeOptions       String?
  canAskQuestion          Boolean?          @default(false)
  nextInstructionBtnLabel String?
  courseModule            CourseModule      @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  instructionAudio        InstructionAudio?
}

model CourseModuleSession {
  id                    String                       @id @default(cuid())
  createdAt             DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                     @default(now()) @db.Timestamptz(6)
  deletedAt             DateTime?                    @db.Timestamptz(6)
  title                 String                       @default("Untitled")
  instructionsCompleted Int
  courseModuleId        String
  userId                String
  documentId            String
  courseModule          CourseModule                 @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  document              Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages              CourseModuleSessionMessage[]
}

model CourseModuleSessionMessage {
  id                    String              @id @default(cuid())
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  courseModuleSessionId String
  instructionId         String
  content               String
  agent                 String
  factCheckPrompt       String?
  context               String?
  courseModuleSession   CourseModuleSession @relation(fields: [courseModuleSessionId], references: [id], onDelete: Cascade)
}

model CourseResource {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  title       String
  description String?
  url         String?
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Document {
  id                   String                @id @default(cuid())
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @db.Timestamptz(6)
  deletedAt            DateTime?             @db.Timestamptz(6)
  title                String                @default("Untitled")
  text                 String?
  html                 String?
  userId               String
  courseModuleSessions CourseModuleSession[]
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments             DocumentComment[]
  versions             DocumentVersion[]
}

model DocumentComment {
  id          String                    @id @default(cuid())
  createdAt   DateTime                  @default(now()) @db.Timestamptz(6)
  userId      String
  content     String
  highlightId String?
  documentId  String
  document    Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses   DocumentCommentResponse[]
}

model DocumentCommentResponse {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  commentId       String
  userId          String
  content         String
  documentComment DocumentComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DocumentVersion {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  documentId String
  text       String
  html       String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  name        String   @unique
  description String?
  isEnabled   Boolean  @default(false)
}

model InstructionAudio {
  id                        String                  @id @default(cuid())
  createdAt                 DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                @default(now()) @db.Timestamptz(6)
  blob                      Bytes
  courseModuleInstructionId String                  @unique
  courseModuleInstruction   CourseModuleInstruction @relation(fields: [courseModuleInstructionId], references: [id], onDelete: Cascade)
}

model Password {
  hash   String
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Permission {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  action      String
  entity      String
  access      String
  description String   @default("")
  roles       Role[]

  @@unique([action, entity, access])
}

model Role {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @db.Timestamptz(6)
  name        String       @unique
  description String       @default("")
  permissions Permission[]
  users       User[]
}

model Session {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)
  expirationDate DateTime @default(now()) @db.Timestamptz(6)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  name      String   @unique
  value     String
  valueType String   @default("string")
}

model StudentProfile {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  userId           String   @unique
  workshopLeaderId String?
  school           String?
  schoolTeacher    String?
  grade            String?
  period           String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workshopLeader   User?    @relation("Students", fields: [workshopLeaderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
}

model StudentView {
  id             String   @id @default(cuid())
  name           String
  school         String?
  grade          String?
  period         String?
  workshopLeader String?
  schoolTeacher  String?
  userId         String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  userId    String   @unique
  isActive  Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Thread {
  id                  String            @id @default(cuid())
  threadId            String            @unique
  name                String
  assistantMetadataId String
  assistantMetadata   AssistantMetadata @relation(fields: [assistantMetadataId], references: [id], onDelete: Cascade)
}

model Upload {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  name        String
  contentType String
  blob        Bytes
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                       String                    @id @default(cuid())
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @db.Timestamptz(6)
  email                    String                    @unique
  name                     String?
  assistants               AssistantMetadata[]
  connections              Connection[]
  courseModuleSessions     CourseModuleSession[]
  documents                Document[]
  documentComments         DocumentComment[]
  documentCommentResponses DocumentCommentResponse[]
  password                 Password?
  sessions                 Session[]
  studentProfile           StudentProfile?
  studentProfiles          StudentProfile[]          @relation("Students")
  studentViews             StudentView[]
  teacherProfile           TeacherProfile?
  uploads                  Upload[]
  image                    UserImage?
  roles                    Role[]
}

model UserImage {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  altText     String?
  contentType String
  blob        Bytes
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  type      String
  target    String
  secret    String
  algorithm String
  digits    Int
  period    Int
  charSet   String
  expiresAt DateTime? @db.Timestamptz(6)
  metadata  String?

  @@unique([target, type])
}
