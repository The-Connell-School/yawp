  updatedAt              DateTime                  @default(now()) @db.Timestamptz(6)
  title                  String
  description            String?
  position               Int
  image                  TeacherTrainingImage?
  teacherTrainingModules TeacherTrainingModule[]
  resources              TeacherTrainingResource[]
  assignedTeachers       OrgMembership[]           @relation("TeacherTrainingAssignments")
}

model TeacherTrainingImage {
  id                String          @id @default(cuid())
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @db.Timestamptz(6)
  altText           String?
  contentType       String
  blob              Bytes
  teacherTrainingId String          @unique
  teacherTraining   TeacherTraining @relation(fields: [teacherTrainingId], references: [id], onDelete: Cascade)
}

model TeacherTrainingModule {
  id                            String                          @id @default(cuid())
  createdAt                     DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime                        @default(now()) @db.Timestamptz(6)
  deletedAt                     DateTime?                       @db.Timestamptz(6)
  title                         String
  position                      Int
  description                   String?
  videoS3Key                    String? /// S3 object key for the module video. Playback will use signed URLs derived from this.
  videoDuration                 Int? // Duration in seconds
  teacherTrainingId             String?
  teacherTraining               TeacherTraining?                @relation(fields: [teacherTrainingId], references: [id], onDelete: Cascade)
  resources                     TeacherTrainingModuleResource[]
  teacherTrainingModuleSessions TeacherTrainingModuleSession[]
}

model TeacherTrainingModuleResource {
  id                      String                @id @default(cuid())
  createdAt               DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime              @default(now()) @db.Timestamptz(6)
  name                    String
  contentType             String
  blob                    Bytes
  teacherTrainingModuleId String
  teacherTrainingModule   TeacherTrainingModule @relation(fields: [teacherTrainingModuleId], references: [id], onDelete: Cascade)
}

model TeacherTrainingResource {
  id                String          @id @default(cuid())
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @db.Timestamptz(6)
  title             String
  description       String?
  url               String?
  teacherTrainingId String
  teacherTraining   TeacherTraining @relation(fields: [teacherTrainingId], references: [id], onDelete: Cascade)
}

model TeacherTrainingModuleSession {
  id                      String                @id @default(cuid())
  createdAt               DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime              @default(now()) @db.Timestamptz(6)
  deletedAt               DateTime?             @db.Timestamptz(6)
  videoTimestamp          Int                   @default(0) // Last watched timestamp in seconds
  teacherTrainingModuleId String
  membershipId            String
  teacherTrainingModule   TeacherTrainingModule @relation(fields: [teacherTrainingModuleId], references: [id], onDelete: Cascade)
  membership              OrgMembership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([teacherTrainingModuleId, membershipId])
}

model PasteAlert {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  textLength   Int
  content      String?
  /// When available, the actual source URL captured by the client at paste time.
  sourceUrl    String?
  documentId   String
  document     Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  membershipId String
  membership   OrgMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt(sort: Desc)])
  @@index([membershipId, createdAt(sort: Desc)])
}

model Submission {
  id                        String                          @id @default(cuid())
  createdAt                 DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                        @default(now()) @db.Timestamptz(6)
  title                     String
  text                      String
  html                      String
  submittedAt               DateTime                        @db.Timestamptz(6)
  score                     String?
  feedback                  String?
  rubricScores              Json?
  overallScore              Int?
  overallComment            String?
  numericPercentage         Int?
  letterGrade               String?
  grammarIssues             Json?
  promptConfig              Json?
  aiMeta                    Json?
  gradedAt                  DateTime?                       @db.Timestamptz(6)
  gradedByMembershipId      String?
  gradedBy                  OrgMembership?                  @relation("SubmissionGradedBy", fields: [gradedByMembershipId], references: [id], onDelete: SetNull)
  releasedAt                DateTime?                       @db.Timestamptz(6)
  /// When set, hidden from the student's active submission list (teachers unaffected).
  archivedAt                DateTime?                       @db.Timestamptz(6)
  /// Teacher-initiated "unsubmit": hidden from both the student and the teacher's
  /// active submission views (grading queues, dashboard cards, editor lock state),
  /// but the row — and any grade/AI feedback already on it — is kept, not deleted.
  /// The underlying Document and its DocumentRevision history are never touched.
  unsubmittedAt             DateTime?                       @db.Timestamptz(6)
  unsubmittedByMembershipId String?
  unsubmittedBy             OrgMembership?                  @relation("SubmissionUnsubmittedBy", fields: [unsubmittedByMembershipId], references: [id], onDelete: SetNull)
  documentId                String
  document                  Document                        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  comments                  SubmissionComment[]
  gradingAssistantRuns      SubmissionGradingAssistantRun[]
  activities                SubmissionActivity[]

  @@index([documentId, submittedAt(sort: Desc)])
  @@index([documentId, archivedAt])
  @@index([documentId, unsubmittedAt])
  @@index([gradedByMembershipId])
  @@index([unsubmittedByMembershipId])
  @@index([releasedAt])
}

/// Append-only audit ledger for current and future submission mutations.
/// Existing submissions are intentionally not backfilled: history begins
/// when application dual-writes start after this table is deployed.
model SubmissionActivity {
  id                   String         @id @default(cuid())
  createdAt            DateTime       @default(now()) @db.Timestamptz(6)
  submissionId         String
  submission           Submission     @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorMembershipId    String?
  /// Composite tenant key prevents an actor membership from another
  /// organization being linked to this activity. The hand-written migration
  /// uses a database trigger to clear actorMembershipId before membership
  /// deletion while retaining organizationId and the actor snapshot.
  actorMembership      OrgMembership? @relation("SubmissionActivityActor", fields: [actorMembershipId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
  actorType            String
  actorName            String?
  actorEmail           String?
  eventType            String
  source               String
  occurredAfterRelease Boolean        @default(false)
  changes              Json
  metadata             Json?

  @@index([submissionId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorMembershipId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
}

model SubmissionGradingAssistantRun {
  id                                 String     @id @default(cuid())
  createdAt                          DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt                          DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  submissionId                       String
  submission                         Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  assignmentTypeId                   String?
  assignmentTypeGradingVersion       Int?
  assignmentTypeRubricSnapshot       Json?
  assignmentTypePromptConfigSnapshot Json?
  source                             String
  model                              String?
  status                             String
  metadata                           Json?

  @@index([submissionId, createdAt(sort: Desc)])
  @@index([assignmentTypeId])
  @@index([status])
}

model SubmissionComment {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @db.Timestamptz(6)
  content      String
  excerpt      String?
  occurrence   Int           @default(1)
  submissionId String
  submission   Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  membershipId String
  membership   OrgMembership @relation("SubmissionCommentProfile", fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt(sort: Desc)])
  @@index([membershipId])
}

model LegacyGradeRedirect {
  gradeId      String   @id
  submissionId String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
}

model LlmLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  model        String
  provider     String // 'anthropic' or 'openai'
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  durationMs   Int?
  systemPrompt String?
  messages     Json // Input messages
  response     String? // Output text
  error        String? // Error message if failed
  metadata     Json? // Any additional context (e.g., caller info)

  @@index([createdAt(sort: Desc)])
  @@index([model])
  @@index([provider])
}

/// Append-only AI usage and admission decision log. No prompts or bodies stored.
model AiUsageDecisionLog {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  route           String
  feature         String?
  /// 'ALLOWED' | 'DENIED_USER' | 'DENIED_ORG' | 'DENIED_IP' | 'DENIED_GLOBAL' | 'DENIED_PAYLOAD' | 'DENIED_CONCURRENCY'
  decision        String
  membershipId    String?
  organizationId  String?
  classId         String?
  /// HMAC of the client IP with a server secret. Never store raw IPs.
  ipHash          String?
  requestId       String
  units           Int
  inputTokens     Int?
  outputTokens    Int?
  latencyMs       Int?
  providerStatus  String?

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([route, createdAt(sort: Desc)])
}

/// Token-bucket state for rate limiting. One row per (subject scope + policy key).
model RateLimitBucket {
  key           String   @id
  tokens        Int      @default(0)
  capacity      Int
  refillPerMs   Float    @default(0) // tokens per millisecond
  lastRefillAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

/// Append-only decision log for rate limit admissions/denials.
model RateLimitDecision {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  route             String
  feature           String?
  scope             String // 'user' | 'org' | 'ip' | 'global'
  decision          String // 'ALLOWED' | 'DENIED_USER' | 'DENIED_ORG' | 'DENIED_IP' | 'DENIED_GLOBAL' | 'DENIED_PAYLOAD' | 'DENIED_CONCURRENCY'
  subjectKey        String
  retryAfterSeconds Int?
  metadata          Json?
  @@index([route, createdAt(sort: Desc)])
  @@index([scope, createdAt(sort: Desc)])
}

/// A single student's persisted response to one practice prompt, with the
/// tutor feedback it produced. Snapshots the prompt text so history survives
/// lesson-content changes.
model WritingPracticeAttempt {
  id                String                         @id @default(cuid())
  createdAt         DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                       @default(now()) @updatedAt @db.Timestamptz(6)
  classAssignmentId String
  classAssignment   WritingPracticeClassAssignment @relation(fields: [classAssignmentId], references: [id], onDelete: Cascade)
  membershipId      String
  membership        OrgMembership                  @relation("WritingPracticeAttemptStudent", fields: [membershipId], references: [id], onDelete: Cascade)
  lessonSlug        String
  promptId          String
  exercise          String
  instruction       String
  response          String
  /// Feedback status: 'strong' | 'developing' | 'needs_revision'.
  status            String
  feedbackJson      Json

  @@index([classAssignmentId, membershipId, createdAt(sort: Desc)])
  @@index([membershipId, createdAt(sort: Desc)])
}

/// A student's generated (or static-fallback) practice sequence for one
/// assignment. Stored so their prompts stay stable across reloads and can be a
/// much larger, non-repeating set than the archived prompt bank.
model WritingPracticePromptSet {
  id                String                         @id @default(cuid())
  createdAt         DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                       @default(now()) @updatedAt @db.Timestamptz(6)
  classAssignmentId String
  classAssignment   WritingPracticeClassAssignment @relation(fields: [classAssignmentId], references: [id], onDelete: Cascade)
  membershipId      String
  membership        OrgMembership                  @relation("WritingPracticePromptSetStudent", fields: [membershipId], references: [id], onDelete: Cascade)
  /// 'ai' when generated by the model, 'static' when the archived bank was used.
  source            String
  promptsJson       Json

  @@unique([classAssignmentId, membershipId])
}

/// Durable receipt and provenance for trusted nonproduction scenario generation.
model InternalScenarioReceipt {
  jobId          String   @id
  actorId        String
  targetId       String
  environment    String
  organizationId String
  requestHash    String
  fingerprint    String
  resources      Json
  receipt        Json
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  retiredAt      DateTime? @db.Timestamptz(6)
  retiredByJobId  String?

  @@index([targetId, organizationId, retiredAt])
}

/// Immutable portable rubric history. Names, rather than environment-local rubric
/// IDs, preserve provenance across local fixture resets and environment transfers.
model RubricRevision {
  id String @id
  rubricName String
  version Int
  schemaJson Json
  fingerprint String
  requestId String @unique
  requestHash String
  sourceContentId String?
  sourceVersion Int?
  sourceFingerprint String?
  createdBy String
  reason String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  currentFor Rubric[] @relation("CurrentRubricRevision")
  assignments Assignment[]
  typeBaselines AssignmentTypeRubricBaseline[]
  @@unique([rubricName, version])
}

/// Baseline mapping from an AssignmentType's current per-type rubric JSON to an immutable revision.
model AssignmentTypeRubricBaseline {
  assignmentTypeId String @id
  rubricRevisionId String
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  assignmentType   AssignmentType  @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
  rubricRevision   RubricRevision  @relation(fields: [rubricRevisionId], references: [id], onDelete: Restrict)

  @@index([rubricRevisionId])
}

/// Audit of rubric pins applied by backfill/baseline-capture. selectedRevisionId may be null for code-default cases.
model InternalAssignmentRubricPinBackfill {
  assignmentId       String   @id
  selectedRevisionId String?
  pinnedAt           DateTime @default(now()) @db.Timestamptz(6)
  reason             String?
}
