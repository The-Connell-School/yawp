generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Connection {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @db.Timestamptz(6)
  providerName String
  providerId   String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerName, providerId])
}

model Course {
  id            String           @id @default(cuid())
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @db.Timestamptz(6)
  title         String
  description   String?
  position      Int
  image         CourseImage?
  courseModules CourseModule[]
  resources     CourseResource[]
}

model CourseImage {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  altText     String?
  contentType String
  blob        Bytes
  courseId    String   @unique
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseModule {
  id                   String                    @id @default(cuid())
  createdAt            DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                  @default(now()) @db.Timestamptz(6)
  deletedAt            DateTime?                 @db.Timestamptz(6)
  title                String
  position             Int
  description          String?
  tutorInstructions    String?
  isSelfGuided         Boolean                   @default(false)
  courseId             String?
  course               Course?                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructions         CourseModuleInstruction[]
  courseModuleSessions CourseModuleSession[]
}

model CourseModuleInstruction {
  id                      String            @id @default(cuid())
  createdAt               DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime          @default(now()) @db.Timestamptz(6)
  courseModuleId          String
  position                Int
  title                   String
  interactiveType         String
  prompt                  String
  tutorInstructions       String?
  answerType              String?
  answerKey               String?
  answerTypeOptions       String?
  canAskQuestion          Boolean?          @default(false)
  nextInstructionBtnLabel String?
  courseModule            CourseModule      @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  instructionAudio        InstructionAudio?
}

model CourseModuleSession {
  id                    String                       @id @default(cuid())
  createdAt             DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                     @default(now()) @db.Timestamptz(6)
  deletedAt             DateTime?                    @db.Timestamptz(6)
  title                 String                       @default("Untitled")
  instructionsCompleted Int
  courseModuleId        String
  userId                String
  documentId            String
  courseModule          CourseModule                 @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  document              Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages              CourseModuleSessionMessage[]
}

model CourseModuleSessionMessage {
  id                    String              @id @default(cuid())
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  courseModuleSessionId String
  instructionId         String
  content               String
  agent                 String
  factCheckPrompt       String?
  context               String?
  courseModuleSession   CourseModuleSession @relation(fields: [courseModuleSessionId], references: [id], onDelete: Cascade)
}

model CourseResource {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  title       String
  description String?
  url         String?
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Document {
  id                   String                @id @default(cuid())
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @db.Timestamptz(6)
  deletedAt            DateTime?             @db.Timestamptz(6)
  title                String                @default("Untitled")
  text                 String?
  html                 String?
  userId               String
  courseModuleSessions CourseModuleSession[]
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments             DocumentComment[]
  versions             DocumentVersion[]
}

model DocumentComment {
  id          String                    @id @default(cuid())
  createdAt   DateTime                  @default(now()) @db.Timestamptz(6)
  userId      String
  content     String
  highlightId String?
  documentId  String
  document    Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses   DocumentCommentResponse[]
}

model DocumentCommentResponse {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  commentId       String
  userId          String
  content         String
  documentComment DocumentComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DocumentVersion {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  documentId String
  text       String
  html       String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  name        String   @unique
  description String?
  isEnabled   Boolean  @default(false)
}

model InstructionAudio {
  id                        String                  @id @default(cuid())
  createdAt                 DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                @default(now()) @db.Timestamptz(6)
  blob                      Bytes
  courseModuleInstructionId String                  @unique
  courseModuleInstruction   CourseModuleInstruction @relation(fields: [courseModuleInstructionId], references: [id], onDelete: Cascade)
}

model Organization {
  id                String         @id @default(cuid())
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @db.Timestamptz(6)
  name              String
  accessExpiresAt   DateTime?      @db.Timestamptz(6)
  numOfStudentSeats Int            @default(10)
  numOfTeacherSeats Int            @default(10)
  users             User[]
  verifications     Verification[]
}

model Password {
  hash   String
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)
  expirationDate DateTime @default(now()) @db.Timestamptz(6)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  name        String   @unique
  description String?
  value       String
  valueType   String   @default("string")
}

model StudentProfile {
  id               String        @id @default(cuid())
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  userId           String        @unique
  workshopLeaderId String?
  teacherClassId   String?
  school           String?
  schoolTeacher    String?
  grade            String?
  period           String?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workshopLeader   User?         @relation("Students", fields: [workshopLeaderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teacherClass     TeacherClass? @relation(fields: [teacherClassId], references: [id], onDelete: SetNull, onUpdate: Cascade)
}


model TeacherProfile {
  id                          String                       @id @default(cuid())
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(6)
  userId                      String                       @unique
  isActive                    Boolean                      @default(true)
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherCourseModuleSessions TeacherCourseModuleSession[]
  teacherClasses              TeacherClass[]
}

model TeacherClass {
  id               String           @id @default(cuid())
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @db.Timestamptz(6)
  name             String
  description      String?
  teacherProfileId String
  teacherProfile   TeacherProfile   @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  students         StudentProfile[]
}

model Upload {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  name        String
  contentType String
  blob        Bytes
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                       String                    @id @default(cuid())
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @db.Timestamptz(6)
  email                    String                    @unique
  name                     String?
  connections              Connection[]
  courseModuleSessions     CourseModuleSession[]
  documents                Document[]
  documentComments         DocumentComment[]
  documentCommentResponses DocumentCommentResponse[]
  organizationId           String?
  organization             Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  password                 Password?
  sessions                 Session[]
  studentProfile           StudentProfile?
  studentProfiles          StudentProfile[]          @relation("Students")
  teacherProfile           TeacherProfile?
  uploads                  Upload[]
  image                    UserImage?
  isAdmin                  Boolean                   @default(false)
  isOwner                  Boolean                   @default(false)
  isSuperOwner             Boolean                   @default(false)
}

model UserImage {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  altText     String?
  contentType String
  blob        Bytes
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  type           String
  target         String
  secret         String
  algorithm      String
  digits         Int
  period         Int
  charSet        String
  expiresAt      DateTime?     @db.Timestamptz(6)
  metadata       String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([target, type])
}

model TeacherCourse {
  id                    String                 @id @default(cuid())
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @db.Timestamptz(6)
  title                 String
  description           String?
  position              Int
  image                 TeacherCourseImage?
  teacherCourseModules  TeacherCourseModule[]
  resources             TeacherCourseResource[]
}

model TeacherCourseImage {
  id               String        @id @default(cuid())
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @db.Timestamptz(6)
  altText          String?
  contentType      String
  blob             Bytes
  teacherCourseId  String        @unique
  teacherCourse    TeacherCourse @relation(fields: [teacherCourseId], references: [id], onDelete: Cascade)
}

model TeacherCourseModule {
  id                          String                       @id @default(cuid())
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                     @default(now()) @db.Timestamptz(6)
  deletedAt                   DateTime?                    @db.Timestamptz(6)
  title                       String
  position                    Int
  description                 String?
  videoLink                   String?
  videoDuration               Int?                         // Duration in seconds
  teacherCourseId             String?
  teacherCourse               TeacherCourse?               @relation(fields: [teacherCourseId], references: [id], onDelete: Cascade)
  resources                   TeacherCourseModuleResource[]
  teacherCourseModuleSessions TeacherCourseModuleSession[]
}

model TeacherCourseModuleResource {
  id                   String              @id @default(cuid())
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @db.Timestamptz(6)
  name                 String
  contentType          String
  blob                 Bytes
  teacherCourseModuleId String
  teacherCourseModule  TeacherCourseModule @relation(fields: [teacherCourseModuleId], references: [id], onDelete: Cascade)
}

model TeacherCourseResource {
  id               String        @id @default(cuid())
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @db.Timestamptz(6)
  title            String
  description      String?
  url              String?
  teacherCourseId  String
  teacherCourse    TeacherCourse @relation(fields: [teacherCourseId], references: [id], onDelete: Cascade)
}

model TeacherCourseModuleSession {
  id                     String              @id @default(cuid())
  createdAt              DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime            @default(now()) @db.Timestamptz(6)
  deletedAt              DateTime?           @db.Timestamptz(6)
  videoProgress          Float               @default(0) // Progress as percentage (0-100)
  videoTimestamp         Int                 @default(0) // Last watched timestamp in seconds
  teacherCourseModuleId  String
  teacherProfileId       String
  teacherCourseModule    TeacherCourseModule @relation(fields: [teacherCourseModuleId], references: [id], onDelete: Cascade)
  teacherProfile         TeacherProfile      @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([teacherCourseModuleId, teacherProfileId])
}
