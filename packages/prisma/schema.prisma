  scoreMaximum       Float
  status             String              @default("pending")
  attemptCount       Int                 @default(0)
  nextAttemptAt      DateTime?           @db.Timestamptz(6)
  deliveredAt        DateTime?           @db.Timestamptz(6)
  deadLetteredAt     DateTime?           @db.Timestamptz(6)
  lastErrorCode      String?
  registrationId     String
  organizationId     String
  courseMappingId    String
  placementId        String
  submissionId       String
  externalIdentityId String
  registration       LtiRegistration     @relation(fields: [registrationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseMapping      LtiCourseMapping    @relation(fields: [courseMappingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  placement          LtiPlacement        @relation(fields: [placementId, organizationId], references: [id, organizationId], onDelete: Cascade)
  submission         Submission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
