generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Class {
  id                    String               @id @default(cuid())
  createdAt             DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime             @default(now()) @db.Timestamptz(6)
  code                  String               @unique
  schoolYear            String               @default("2024-2025")
  period                String
  grade                 String
  title                 String?
  isArchived            Boolean              @default(false)
  students              StudentProfile[]
  teachers              TeacherProfile[]
  schoolId              String
  school                School               @relation(fields: [schoolId], references: [id])
  documents             Document[]
  allowedStudentCourses ClassStudentCourse[]

  @@unique([schoolId, schoolYear, period, grade])
}

model StudentCourse {
  id                   String                @id @default(cuid())
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @db.Timestamptz(6)
  title                String
  description          String?
  position             Int
  image                StudentCourseImage?
  studentCourseModules StudentCourseModule[]
  allowedInClasses     ClassStudentCourse[]
}

model StudentCourseImage {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @db.Timestamptz(6)
  altText         String?
  contentType     String
  blob            Bytes
  studentCourseId String        @unique
  studentCourse   StudentCourse @relation(fields: [studentCourseId], references: [id], onDelete: Cascade)
}

model StudentCourseModule {
  id                          String                           @id @default(cuid())
  createdAt                   DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                         @default(now()) @db.Timestamptz(6)
  deletedAt                   DateTime?                        @db.Timestamptz(6)
  title                       String
  position                    Int
  description                 String?
  tutorInstructions           String?
  isSelfGuided                Boolean                          @default(false)
  studentCourseId             String?
  studentCourse               StudentCourse?                   @relation(fields: [studentCourseId], references: [id], onDelete: Cascade)
  instructions                StudentCourseModuleInstruction[]
  studentCourseModuleSessions StudentCourseModuleSession[]
}

model StudentCourseModuleInstruction {
  id                    String                                 @id @default(cuid())
  createdAt             DateTime                               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                               @default(now()) @db.Timestamptz(6)
  position              Int
  title                 String
  prompt                String
  tutorInstructions     String?
  showChatButton        Boolean?                               @default(false)
  showNextButton        Boolean?                               @default(true)
  studentCourseModuleId String
  studentCourseModule   StudentCourseModule                    @relation(fields: [studentCourseModuleId], references: [id], onDelete: Cascade)
  instructionAudio      InstructionAudio?
  buttons               StudentCourseModuleInstructionButton[]
}

model StudentCourseModuleInstructionButton {
  id                               String                         @id @default(cuid())
  createdAt                        DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt                        DateTime                       @default(now()) @db.Timestamptz(6)
  position                         Int
  label                            String
  action                           String // 'advance' or 'response'
  studentCourseModuleInstructionId String
  studentCourseModuleInstruction   StudentCourseModuleInstruction @relation(fields: [studentCourseModuleInstructionId], references: [id], onDelete: Cascade)
}

model StudentCourseModuleSession {
  id                    String                              @id @default(cuid())
  createdAt             DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                            @default(now()) @db.Timestamptz(6)
  deletedAt             DateTime?                           @db.Timestamptz(6)
  title                 String                              @default("Untitled")
  instructionsCompleted Int
  studentCourseModuleId String
  studentCourseModule   StudentCourseModule                 @relation(fields: [studentCourseModuleId], references: [id], onDelete: Cascade)
  documentId            String
  document              Document                            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  studentProfileId      String
  studentProfile        StudentProfile                      @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  messages              StudentCourseModuleSessionMessage[]
}

model StudentCourseModuleSessionMessage {
  id                           String                     @id @default(cuid())
  createdAt                    DateTime                   @default(now()) @db.Timestamptz(6)
  instructionId                String
  content                      String
  agent                        String
  factCheckPrompt              String?
  context                      String?
  studentCourseModuleSessionId String
  studentCourseModuleSession   StudentCourseModuleSession @relation(fields: [studentCourseModuleSessionId], references: [id], onDelete: Cascade)
}

model Document {
  id                          String                       @id @default(cuid())
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                     @default(now()) @db.Timestamptz(6)
  deletedAt                   DateTime?                    @db.Timestamptz(6)
  archivedAt                  DateTime?                    @db.Timestamptz(6)
  title                       String                       @default("Untitled")
  text                        String?
  html                        String?
  submittedAt                 DateTime?                    @db.Timestamptz(6)
  submittedSnapshotId         String?
  submittedSnapshot           DocumentSnapshot?            @relation("DocumentSubmission", fields: [submittedSnapshotId], references: [id], onDelete: SetNull)
  profile                     Profile                      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId                   String
  classId                     String?
  class                       Class?                       @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentCourseModuleSessions StudentCourseModuleSession[]
  comments                    DocumentComment[]
  versions                    DocumentVersion[]
  snapshots                   DocumentSnapshot[]
  pasteAlerts                 PasteAlert[]
}

model DocumentComment {
  id          String                    @id @default(cuid())
  createdAt   DateTime                  @default(now()) @db.Timestamptz(6)
  content     String
  highlightId String?
  documentId  String
  document    Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  profile     Profile                   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  responses   DocumentCommentResponse[]
}

model DocumentCommentResponse {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  content         String
  commentId       String
  documentComment DocumentComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profileId       String
  profile         Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model DocumentVersion {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  text       String
  html       String
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DocumentSnapshot {
  id                    String     @id @default(cuid())
  createdAt             DateTime   @default(now()) @db.Timestamptz(6)
  text                  String
  html                  String
  documentId            String
  document              Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  submittedDocuments    Document[] @relation("DocumentSubmission")
  grades                Grade[]

  @@index([documentId, createdAt(sort: Desc)])
}

model Grade {
  id         String            @id @default(cuid())
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime          @default(now()) @db.Timestamptz(6)
  score      String?           // Flexible: can be letter grade, number, or text
  feedback   String?           // Teacher's written feedback
  rubricScores Json?
  overallScore Int?
  overallComment String?
  aiMeta     Json?
  releasedAt DateTime?         @db.Timestamptz(6) // When released to student (null = not released)
  snapshotId String            @unique // Grade is tied to specific submission snapshot
  snapshot   DocumentSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  gradedById String
  gradedBy   Profile           @relation(fields: [gradedById], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([gradedById])
  @@index([releasedAt])
}

model InstructionAudio {
  id                               String                         @id @default(cuid())
  createdAt                        DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt                        DateTime                       @default(now()) @db.Timestamptz(6)
  blob                             Bytes
  studentCourseModuleInstructionId String                         @unique
  studentCourseModuleInstruction   StudentCourseModuleInstruction @relation(fields: [studentCourseModuleInstructionId], references: [id], onDelete: Cascade)
}

model Organization {
  id                String       @id @default(cuid())
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @db.Timestamptz(6)
  name              String
  accessExpiresAt   DateTime?    @db.Timestamptz(6)
  numOfStudentSeats Int          @default(10)
  numOfTeacherSeats Int          @default(10)
  profiles          Profile[]
  invitations       Invitation[]
  schools           School[]
}

model Profile {
  id                       String                    @id @default(cuid())
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  organizationId           String
  organization             Organization              @relation(fields: [organizationId], references: [id])
  userId                   String
  user                     User                      @relation(fields: [userId], references: [id])
  documents                Document[]
  documentComments         DocumentComment[]
  documentCommentResponses DocumentCommentResponse[]
  pasteAlerts              PasteAlert[]
  gradesGiven              Grade[]
  studentProfile           StudentProfile?
  teacherProfile           TeacherProfile?
  isOwner                  Boolean                   @default(false)
}

model Password {
  hash   String
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model School {
  id             String           @id @default(cuid())
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @db.Timestamptz(6)
  name           String
  code           String           @unique
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  classes        Class[]
  teachers       TeacherProfile[]
  invitations    Invitation[]
}

model Session {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)
  expirationDate DateTime @default(now()) @db.Timestamptz(6)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  name        String   @unique
  description String?
  value       String
  valueType   String   @default("string")
}

model StudentProfile {
  id                          String                       @id @default(cuid())
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(6)
  school                      String?
  schoolTeacher               String?
  grade                       String?
  period                      String?
  profileId                   String                       @unique
  profile                     Profile                      @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  classes                     Class[]
  studentCourseModuleSessions StudentCourseModuleSession[]
}

model TeacherProfile {
  id                          String                       @id @default(cuid())
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(6)
  isActive                    Boolean                      @default(true)
  profileId                   String                       @unique
  profile                     Profile                      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  teacherCourseModuleSessions TeacherCourseModuleSession[]
  assignedTeacherCourses      TeacherCourse[]              @relation("TeacherCourseAssignments")
  classes                     Class[]
  schools                     School[]
}

// Upload table removed. Videos will be stored in S3 and referenced by key.

model User {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @db.Timestamptz(6)
  email     String    @unique
  name      String?
  password  Password?
  sessions  Session[]
  profiles  Profile[]
  isAdmin   Boolean   @default(false)
}

model Invitation {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  type           String
  target         String
  secret         String
  algorithm      String
  digits         Int
  period         Int
  charSet        String
  expiresAt      DateTime?     @db.Timestamptz(6)
  metadata       String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolId       String?
  school         School?       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([target, type])
}

model TeacherCourse {
  id                   String                  @id @default(cuid())
  createdAt            DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                @default(now()) @db.Timestamptz(6)
  title                String
  description          String?
  position             Int
  image                TeacherCourseImage?
  teacherCourseModules TeacherCourseModule[]
  resources            TeacherCourseResource[]
  assignedTeachers     TeacherProfile[]        @relation("TeacherCourseAssignments")
}

model TeacherCourseImage {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @db.Timestamptz(6)
  altText         String?
  contentType     String
  blob            Bytes
  teacherCourseId String        @unique
  teacherCourse   TeacherCourse @relation(fields: [teacherCourseId], references: [id], onDelete: Cascade)
}

model TeacherCourseModule {
  id                          String                        @id @default(cuid())
  createdAt                   DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                      @default(now()) @db.Timestamptz(6)
  deletedAt                   DateTime?                     @db.Timestamptz(6)
  title                       String
  position                    Int
  description                 String?
  videoS3Key                  String? /// S3 object key for the module video. Playback will use signed URLs derived from this.
  videoDuration               Int? // Duration in seconds
  teacherCourseId             String?
  teacherCourse               TeacherCourse?                @relation(fields: [teacherCourseId], references: [id], onDelete: Cascade)
  resources                   TeacherCourseModuleResource[]
  teacherCourseModuleSessions TeacherCourseModuleSession[]
}

model TeacherCourseModuleResource {
  id                    String              @id @default(cuid())
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime            @default(now()) @db.Timestamptz(6)
  name                  String
  contentType           String
  blob                  Bytes
  teacherCourseModuleId String
  teacherCourseModule   TeacherCourseModule @relation(fields: [teacherCourseModuleId], references: [id], onDelete: Cascade)
}

model TeacherCourseResource {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @db.Timestamptz(6)
  title           String
  description     String?
  url             String?
  teacherCourseId String
  teacherCourse   TeacherCourse @relation(fields: [teacherCourseId], references: [id], onDelete: Cascade)
}

model TeacherCourseModuleSession {
  id                    String              @id @default(cuid())
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime            @default(now()) @db.Timestamptz(6)
  deletedAt             DateTime?           @db.Timestamptz(6)
  videoTimestamp        Int                 @default(0) // Last watched timestamp in seconds
  teacherCourseModuleId String
  teacherProfileId      String
  teacherCourseModule   TeacherCourseModule @relation(fields: [teacherCourseModuleId], references: [id], onDelete: Cascade)
  teacherProfile        TeacherProfile      @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([teacherCourseModuleId, teacherProfileId])
}

model ClassStudentCourse {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  classId         String
  class           Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentCourseId String
  studentCourse   StudentCourse @relation(fields: [studentCourseId], references: [id], onDelete: Cascade)

  @@unique([classId, studentCourseId])
}

model PasteAlert {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  textLength Int
  content    String?
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt(sort: Desc)])
  @@index([profileId, createdAt(sort: Desc)])
}

model LlmLog {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  model          String
  provider       String   // 'anthropic' or 'openai'
  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?
  durationMs     Int?
  systemPrompt   String?
  messages       Json     // Input messages
  response       String?  // Output text
  error          String?  // Error message if failed
  metadata       Json?    // Any additional context (e.g., caller info)

  @@index([createdAt(sort: Desc)])
  @@index([model])
  @@index([provider])
}
