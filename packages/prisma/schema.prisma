model PasteAlert {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  textLength   Int
  content      String?
  documentId   String
  document     Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  membershipId String
  membership   OrgMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt(sort: Desc)])
  @@index([membershipId, createdAt(sort: Desc)])
}

model Submission {
  id                        String                          @id @default(cuid())
  createdAt                 DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                        @default(now()) @db.Timestamptz(6)
  title                     String
  text                      String
  html                      String
  submittedAt               DateTime                        @db.Timestamptz(6)
  score                     String?
  feedback                  String?
  rubricScores              Json?
  overallScore              Int?
  overallComment            String?
  numericPercentage         Int?
  letterGrade               String?
  grammarIssues             Json?
  promptConfig              Json?
  aiMeta                    Json?
  gradedAt                  DateTime?                       @db.Timestamptz(6)
  gradedByMembershipId      String?
  gradedBy                  OrgMembership?                  @relation("SubmissionGradedBy", fields: [gradedByMembershipId], references: [id], onDelete: SetNull)
  releasedAt                DateTime?                       @db.Timestamptz(6)
  /// When set, hidden from the student's active submission list (teachers unaffected).
  archivedAt                DateTime?                       @db.Timestamptz(6)
  /// Teacher-initiated "unsubmit": hidden from both the student and the teacher's
  /// active submission views (grading queues, dashboard cards, editor lock state),
  /// but the row — and any grade/AI feedback already on it — is kept, not deleted.
  /// The underlying Document and its DocumentRevision history are never touched.
  unsubmittedAt             DateTime?                       @db.Timestamptz(6)
  unsubmittedByMembershipId String?
  unsubmittedBy             OrgMembership?                  @relation("SubmissionUnsubmittedBy", fields: [unsubmittedByMembershipId], references: [id], onDelete: SetNull)
  documentId                String
  document                  Document                        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  comments                  SubmissionComment[]
  gradingAssistantRuns      SubmissionGradingAssistantRun[]
  activities                SubmissionActivity[]

  @@index([documentId, submittedAt(sort: Desc)])
  @@index([documentId, archivedAt])
  @@index([documentId, unsubmittedAt])
  @@index([gradedByMembershipId])
  @@index([unsubmittedByMembershipId])
  @@index([releasedAt])
}

/// Append-only audit ledger for current and future submission mutations.
/// Existing submissions are intentionally not backfilled: history begins
/// when application dual-writes start after this table is deployed.
model SubmissionActivity {
  id                   String         @id @default(cuid())
  createdAt            DateTime       @default(now()) @db.Timestamptz(6)
  submissionId         String
  submission           Submission     @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorMembershipId    String?
  /// Composite tenant key prevents an actor membership from another
  /// organization being linked to this activity. The hand-written migration
  /// uses a database trigger to clear actorMembershipId before membership
  /// deletion while retaining organizationId and the actor snapshot.
  actorMembership      OrgMembership? @relation("SubmissionActivityActor", fields: [actorMembershipId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
  actorType            String
  actorName            String?
  actorEmail           String?
  eventType            String
  source               String
  occurredAfterRelease Boolean        @default(false)
  changes              Json
  metadata             Json?

  @@index([submissionId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorMembershipId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
}

model SubmissionGradingAssistantRun {
  id                                 String     @id @default(cuid())
  createdAt                          DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt                          DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  submissionId                       String
  submission                         Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  assignmentTypeId                   String?
  assignmentTypeGradingVersion       Int?
  assignmentTypeRubricSnapshot       Json?
  assignmentTypePromptConfigSnapshot Json?
  source                             String
  model                              String?
  status                             String
  metadata                           Json?

  @@index([submissionId, createdAt(sort: Desc)])
  @@index([assignmentTypeId])
  @@index([status])
}

model SubmissionComment {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @db.Timestamptz(6)
  content      String
  excerpt      String?
  occurrence   Int           @default(1)
  submissionId String
  submission   Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  membershipId String
  membership   OrgMembership @relation("SubmissionCommentProfile", fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt(sort: Desc)])
  @@index([membershipId])
}

model LegacyGradeRedirect {
  gradeId      String   @id
  submissionId String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
}

model LlmLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  model        String
  provider     String // 'anthropic' or 'openai'
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  durationMs   Int?
  systemPrompt String?
  messages     Json // Input messages
  response     String? // Output text
  error        String? // Error message if failed
  metadata     Json? // Any additional context (e.g., caller info)

  @@index([createdAt(sort: Desc)])
  @@index([model])
  @@index([provider])
}
