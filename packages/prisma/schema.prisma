generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  TEACHER
  STUDENT
}

enum StudentLicenseStatus {
  PENDING
  ACTIVE
  REFUNDED
  DISPUTED
  REVOKED
}

enum StudentLicenseSource {
  STRIPE_CHECKOUT
  EXISTING_SUBSCRIPTION
  MANUAL
}

model Class {
  id                              String                           @id @default(cuid())
  createdAt                       DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime                         @default(now()) @db.Timestamptz(6)
  code                            String
  schoolYear                      String                           @default("2024-2025")
  period                          String?
  grade                           String?
  title                           String?
  cardGradientKey                 String                           @default("indigo-purple-pink")
  classArtIndex                   Int?
  classArtKey                     String?
  isArchived                      Boolean                          @default(false)
  students                        OrgMembership[]                  @relation("ClassStudents")
  teachers                        OrgMembership[]                  @relation("ClassTeachers")
  schoolId                        String
  school                          School                           @relation(fields: [schoolId], references: [id])
  classAssignments                ClassAssignment[]
  writingPracticeClassAssignments WritingPracticeClassAssignment[]

  @@unique([schoolId, code])
  @@index([schoolId, schoolYear, period, grade])
}

/// A whole grading rubric as one portable object: scale, categories, prompt
/// configuration, output schema and calibration notes together. Rubrics are
/// written elsewhere and pasted in, which is what makes them movable between
/// environments — the JSON is the transfer format.
model Rubric {
  id              String           @id @default(cuid())
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  /// Stable identifier used to match the same rubric across environments.
  name            String           @unique
  /// What an admin sees in the picker.
  title           String
  schemaJson      Json
  assignmentTypes AssignmentType[]

  @@index([title])
}

model AssignmentType {
  id                                 String                        @id @default(cuid())
  createdAt                          DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt                          DateTime                      @default(now()) @db.Timestamptz(6)
  title                              String
  kind                               String?                       @unique
  description                        String?
  position                           Int
  systemKey                          String?                       @unique
  archivedAt                         DateTime?                     @db.Timestamptz(6)
  ownerOrgId                         String?
  ownerOrg                           Organization?                 @relation(fields: [ownerOrgId], references: [id], onDelete: Cascade)
  ownerMembershipId                  String?
  ownerMembership                    OrgMembership?                @relation("AssignmentTypeOwner", fields: [ownerMembershipId], references: [id], onDelete: Cascade)
  /// The rubric this assignment type grades with, chosen from the shared
  /// library. Null keeps the older behaviour: its own JSON columns below, or
  /// the built-in default for its kind.
  rubricId                           String?
  rubric                             Rubric?                       @relation(fields: [rubricId], references: [id])
  scoringScaleJson                   Json?
  rubricJson                         Json?
  gradingPromptConfigJson            Json?
  gradingOutputSchemaJson            Json?
  gradingCalibrationNotes            String?
  gradingAssistantVersion            Int                           @default(1)
  gradingAssistantSourceTemplateId   String?
  gradingAssistantSourceTemplateSlug String?
  image                              AssignmentTypeImage?
  organizationAssignments            OrganizationAssignmentType[]
  schoolAssignments                  SchoolAssignmentType[]
  teacherAssignments                 TeacherAssignmentType[]
  assignmentModules                  AssignmentModule[]
  assignments                        Assignment[]
  documents                          Document[]
  apHistoryLibraryEntries            ApHistoryPromptLibraryEntry[]
  savedThesisPrompts                 SavedThesisPrompt[]
  savedDailyPagesPrompts             SavedDailyPagesPrompt[]
  savedAssignments                   SavedAssignment[]

  @@index([ownerOrgId])
  @@index([ownerMembershipId])
  @@index([archivedAt])
  @@index([systemKey])
  @@index([kind])
}

model Assignment {
  id                              String            @id @default(cuid())
  createdAt                       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime          @default(now()) @db.Timestamptz(6)
  assignmentTypeId                String
  assignmentType                  AssignmentType    @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
  title                           String?
  prompt                          String
  promptAttachmentKey             String?
  promptAttachmentName            String?
  promptAttachmentSize            Int?
  submitForGrade                  Boolean           @default(true)
  pointValue                      Int?              @default(100)
  gradingAssistantStrictnessLevel String            @default("intermediate")
  tutorEnabled                    Boolean           @default(true)
  apHistorySnapshot               Json?
  classAssignments                ClassAssignment[]
  documents                       Document[]

  @@index([assignmentTypeId])
}

model ClassAssignment {
  id           String                  @id @default(cuid())
  createdAt    DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                @default(now()) @db.Timestamptz(6)
  assignmentId String
  assignment   Assignment              @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  classId      String
  class        Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  /// When set in the future, students do not see this assignment yet.
  postAt       DateTime?               @db.Timestamptz(6)
  /// Optional due date for this class's deployment of the assignment.
  dueAt        DateTime?               @db.Timestamptz(6)
  documents    Document[]
  insight      ClassAssignmentInsight?

  @@unique([assignmentId, classId])
  @@index([classId, createdAt(sort: Desc)])
  @@index([postAt])
  @@index([dueAt])
}

/// Class-wide, assignment-level feedback for the teacher: an AI summary of how
/// the whole class did on one assignment (strengths, gaps, teaching next steps).
/// One cached row per ClassAssignment; regenerated on demand.
model ClassAssignmentInsight {
  id                      String          @id @default(cuid())
  createdAt               DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  classAssignmentId       String          @unique
  classAssignment         ClassAssignment @relation(fields: [classAssignmentId], references: [id], onDelete: Cascade)
  status                  String          @default("ready") // ready | failed
  model                   String?
  submissionCount         Int             @default(0)
  summaryJson             Json?
  generatedByMembershipId String?
  generatedByMembership   OrgMembership?  @relation(fields: [generatedByMembershipId], references: [id], onDelete: SetNull)
  generatedAt             DateTime?       @db.Timestamptz(6)

  @@index([generatedByMembershipId])
}

/// A thesis-driven essay prompt a teacher generated and kept ("My prompts").
/// Keyed by a hash of the prompt body so saving and then using the same draft
/// leaves a single row.
model SavedThesisPrompt {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  membershipId     String
  membership       OrgMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  assignmentTypeId String
  assignmentType   AssignmentType @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
  title            String
  prompt           String
  promptHash       String
  source           String         @default("generator")
  archivedAt       DateTime?      @db.Timestamptz(6)

  @@unique([membershipId, assignmentTypeId, promptHash])
  @@index([membershipId, assignmentTypeId, archivedAt])
}

/// A Daily Pages prompt a teacher generated and kept ("My prompts").
/// Keyed by a hash of the prompt text so saving and then using the same draft
/// leaves a single row. `facets` holds the generator's library-vocabulary tags
/// ({ type, seriousness, cognitiveMoves }) so a saved prompt filters and reads
/// like a corpus row; it is validated on the way out, never trusted raw.
model SavedDailyPagesPrompt {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  membershipId     String
  membership       OrgMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  assignmentTypeId String
  assignmentType   AssignmentType @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
  prompt           String
  promptHash       String
  facets           Json?
  source           String         @default("generator")
  archivedAt       DateTime?      @db.Timestamptz(6)

  // Named explicitly: the default names would run past Postgres's 63-byte
  // identifier limit and be silently truncated.
  @@unique([membershipId, assignmentTypeId, promptHash], map: "SavedDailyPagesPrompt_membership_type_promptHash_key")
  @@index([membershipId, assignmentTypeId, archivedAt], map: "SavedDailyPagesPrompt_membership_type_archivedAt_idx")
}

/// An assignment a teacher kept for reuse ("My Saved Assignments"). This is a
/// configuration, not a deployment: it holds the assignment type, title,
/// prompt and the grading/tutor settings, and reusing one pre-fills the
/// creation sheet. Keyed by a hash of the prompt body so saving the same
/// assignment twice leaves a single row.
model SavedAssignment {
  id                              String         @id @default(cuid())
  createdAt                       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  membershipId                    String
  membership                      OrgMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  assignmentTypeId                String
  assignmentType                  AssignmentType @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
  title                           String
  prompt                          String
  promptHash                      String
  submitForGrade                  Boolean        @default(true)
  pointValue                      Int?
  gradingAssistantStrictnessLevel String         @default("intermediate")
  tutorEnabled                    Boolean        @default(true)
  source                          String         @default("creation-sheet")
  archivedAt                      DateTime?      @db.Timestamptz(6)

  // Named explicitly: the default names would run past Postgres's 63-byte
  // identifier limit and be silently truncated.
  @@unique([membershipId, assignmentTypeId, promptHash], map: "SavedAssignment_membership_type_promptHash_key")
  @@index([membershipId, archivedAt], map: "SavedAssignment_membership_archivedAt_idx")
  @@index([assignmentTypeId], map: "SavedAssignment_assignmentTypeId_idx")
}

model ApHistoryPromptLibraryEntry {
  id                     String                         @id @default(cuid())
  createdAt              DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                       @default(now()) @updatedAt @db.Timestamptz(6)
  externalKey            String                         @unique
  assignmentTypeId       String
  assignmentType         AssignmentType                 @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
  course                 String
  essayType              String
  title                  String
  prompt                 String
  period                 String
  periodNumber           Int
  reasoningSkill         String
  difficulty             String
  skillEmphasis          String?
  defaultTimeMode        String                         @default("untimed")
  defaultDurationMinutes Int
  provenanceUrl          String?
  archivedAt             DateTime?                      @db.Timestamptz(6)
  sources                ApHistoryPromptLibrarySource[]

  @@index([assignmentTypeId, essayType])
  @@index([course, periodNumber])
  @@index([archivedAt])
}

model ApHistoryPromptLibrarySource {
  id                   String                      @id @default(cuid())
  createdAt            DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)
  externalKey          String                      @unique
  promptLibraryEntryId String
  promptLibraryEntry   ApHistoryPromptLibraryEntry @relation(fields: [promptLibraryEntryId], references: [id], onDelete: Cascade)
  position             Int
  title                String
  attribution          String
  body                 String
  caption              String?
  mediaType            String                      @default("text")
  imageUrl             String?
  imageAlt             String?
  provenanceUrl        String?

  @@index([promptLibraryEntryId, position])
}

model AssignmentTypeImage {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @db.Timestamptz(6)
  altText          String?
  contentType      String
  blob             Bytes
  assignmentTypeId String         @unique
  assignmentType   AssignmentType @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
}

model AssignmentModule {
  id                  String                        @id @default(cuid())
  createdAt           DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                      @default(now()) @db.Timestamptz(6)
  deletedAt           DateTime?                     @db.Timestamptz(6)
  title               String
  position            Int
  description         String?
  tutorInstructions   String?
  isSelfGuided        Boolean                       @default(false)
  rubricAlignmentJson Json?
  assignmentTypeId    String
  assignmentType      AssignmentType                @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)
  instructions        AssignmentModuleInstruction[]
  sessions            AssignmentModuleSession[]
}

model AssignmentModuleInstruction {
  id                 String                              @id @default(cuid())
  createdAt          DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                            @default(now()) @db.Timestamptz(6)
  position           Int
  title              String
  prompt             String
  tutorInstructions  String?
  showChatButton     Boolean?                            @default(false)
  showNextButton     Boolean?                            @default(true)
  assignmentModuleId String
  assignmentModule   AssignmentModule                    @relation(fields: [assignmentModuleId], references: [id], onDelete: Cascade)
  buttons            AssignmentModuleInstructionButton[]
}

model AssignmentModuleInstructionButton {
  id                            String                      @id @default(cuid())
  createdAt                     DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime                    @default(now()) @db.Timestamptz(6)
  position                      Int
  label                         String
  action                        String // 'advance' or 'response'
  assignmentModuleInstructionId String
  assignmentModuleInstruction   AssignmentModuleInstruction @relation(fields: [assignmentModuleInstructionId], references: [id], onDelete: Cascade)
}

model AssignmentModuleSession {
  id                    String                           @id @default(cuid())
  createdAt             DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                         @default(now()) @db.Timestamptz(6)
  deletedAt             DateTime?                        @db.Timestamptz(6)
  title                 String                           @default("Untitled")
  instructionsCompleted Int
  assignmentModuleId    String
  assignmentModule      AssignmentModule                 @relation(fields: [assignmentModuleId], references: [id], onDelete: Cascade)
  documentId            String
  document              Document                         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  messages              AssignmentModuleSessionMessage[]
}

model AssignmentModuleSessionMessage {
  id                        String                  @id @default(cuid())
  createdAt                 DateTime                @default(now()) @db.Timestamptz(6)
  instructionId             String
  content                   String
  agent                     String
  factCheckPrompt           String?
  context                   String?
  assignmentModuleSessionId String
  assignmentModuleSession   AssignmentModuleSession @relation(fields: [assignmentModuleSessionId], references: [id], onDelete: Cascade)
}

model Document {
  id                       String                    @id @default(cuid())
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @db.Timestamptz(6)
  revision                 Int                       @default(0)
  deletedAt                DateTime?                 @db.Timestamptz(6)
  archivedAt               DateTime?                 @db.Timestamptz(6)
  title                    String                    @default("Untitled")
  text                     String?
  html                     String?
  membership               OrgMembership             @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipId             String
  assignmentTypeId         String
  assignmentType           AssignmentType            @relation(fields: [assignmentTypeId], references: [id], onDelete: Restrict)
  assignmentId             String?
  assignment               Assignment?               @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  classAssignmentId        String?
  classAssignment          ClassAssignment?          @relation(fields: [classAssignmentId], references: [id], onDelete: SetNull)
  assignmentModuleSessions AssignmentModuleSession[]
  comments                 DocumentComment[]
  writeJournals            DocumentWriteJournal[]
  pasteAlerts              PasteAlert[]
  revisions                DocumentRevision[]
  submissions              Submission[]

  @@index([assignmentId])
  @@index([classAssignmentId])
  @@index([assignmentTypeId])
  @@index([membershipId])
}

model DocumentClassForensic {
  documentId String   @id
  oldClassId String
  capturedAt DateTime @default(now()) @db.Timestamptz(6)
}

model AssignmentModuleSessionStudentForensic {
  sessionId           String   @id
  oldStudentProfileId String
  documentId          String
  capturedAt          DateTime @default(now()) @db.Timestamptz(6)

  @@index([documentId])
  @@index([oldStudentProfileId])
}

model ClassStudentCourseForensic {
  classId         String
  studentCourseId String
  capturedAt      DateTime @default(now()) @db.Timestamptz(6)

  @@id([classId, studentCourseId])
}

// Forensic archives from the 2026-06-12 assignment-template split and the
// 2026-06-13 OrgMembership cutover (see
// docs/superpowers/plans/2026-06-13-org-membership-cutover-runbook.md).
// These tables were created by hand-written migrations and are read by
// packages/prisma/scripts/org-membership-staging-verify.ts; they were never
// declared in this schema, which made `prisma migrate dev` propose dropping
// them. Declaring them here stops that false-positive drift.
model AssignmentClassIdForensic {
  assignmentId String   @id
  classId      String
  capturedAt   DateTime @default(now()) @db.Timestamptz(6)
}

model AssignmentDueDateForensic {
  assignmentId String   @id
  dueDate      DateTime @db.Timestamptz(6)
  capturedAt   DateTime @default(now()) @db.Timestamptz(6)
}

model DocumentStudentProfileIdForensic {
  documentId       String   @id
  studentProfileId String
  capturedAt       DateTime @default(now()) @db.Timestamptz(6)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model FeatureAccessTargetTeacherForensic {
  id         String?
  createdAt  DateTime? @db.Timestamptz(6)
  updatedAt  DateTime? @db.Timestamptz(6)
  featureKey String?
  targetKind String?
  targetId   String?
  enabled    Boolean?
  expiresAt  DateTime? @db.Timestamptz(6)
  note       String?
  capturedAt DateTime? @db.Timestamptz(6)

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model ProfileDuplicateForensic {
  id             String?
  createdAt      DateTime?       @db.Timestamptz(6)
  organizationId String?
  userId         String?
  isOrgOwner     Boolean?
  role           MembershipRole?
  isActive       Boolean?
  school         String?
  schoolTeacher  String?
  grade          String?
  period         String?
  archivedAt     DateTime?       @db.Timestamptz(6)

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model ProfileOrphanForensic {
  id             String?
  createdAt      DateTime?       @db.Timestamptz(6)
  organizationId String?
  userId         String?
  isOrgOwner     Boolean?
  role           MembershipRole?
  isActive       Boolean?
  school         String?
  schoolTeacher  String?
  grade          String?
  period         String?
  archivedAt     DateTime?       @db.Timestamptz(6)

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model StudentProfileForensic {
  id            String?
  createdAt     DateTime? @db.Timestamptz(6)
  school        String?
  schoolTeacher String?
  grade         String?
  period        String?
  profileId     String?

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model TeacherProfileForensic {
  id        String?
  createdAt DateTime? @db.Timestamptz(6)
  isActive  Boolean?
  profileId String?

  @@ignore
}

model DocumentComment {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now()) @db.Timestamptz(6)
  archivedAt   DateTime?                 @db.Timestamptz(6)
  content      String
  highlightId  String?
  documentId   String
  document     Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  membership   OrgMembership             @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipId String
  responses    DocumentCommentResponse[]
}

model DocumentCommentResponse {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  content         String
  commentId       String
  documentComment DocumentComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  membershipId    String
  membership      OrgMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model DocumentRevision {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  html       String
  text       String
  trigger    String

  @@index([documentId, createdAt(sort: Desc)])
}

model DocumentWriteJournal {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  eventType         String
  source            String
  status            String
  failureReason     String?
  requestId         String?
  traceId           String?
  userId            String?
  membershipId      String?
  sessionId         String?
  editorSessionId   String?
  clientSeq         Int?
  baseRevision      Int?
  resultingRevision Int?
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title             String?
  html              String
  text              String
  htmlHash          String
  textHash          String
  metadata          Json?

  @@index([documentId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([requestId])
  @@index([traceId])
  @@index([editorSessionId, clientSeq(sort: Desc)])
}

model Organization {
  id                        String                       @id @default(cuid())
  createdAt                 DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                     @default(now()) @db.Timestamptz(6)
  name                      String
  accessExpiresAt           DateTime?                    @db.Timestamptz(6)
  numOfStudentSeats         Int                          @default(10)
  numOfTeacherSeats         Int                          @default(10)
  reporterEnabled           Boolean                      @default(false)
  classInsightsEnabled      Boolean                      @default(false)
  writingPracticeEnabled    Boolean                      @default(false)
  submissionActivityEnabled Boolean                      @default(false)
  previewSeatCode           String?                      @unique
  memberships               OrgMembership[]
  invitations               Invitation[]
  schools                   School[]
  assignmentTypes           AssignmentType[]
  assignmentTypeAssignments OrganizationAssignmentType[]
  reporterConversations     ReporterConversation[]
  reporterGrowthPlans       ReporterGrowthPlan[]
  aiRequestReservations     AiRequestReservation[]
  submissionActivities      SubmissionActivity[]
  studentLicenses           StudentLicense[]
}

model OrganizationAssignmentType {
  organizationId   String
  assignmentTypeId String
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignmentType   AssignmentType @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)

  @@id([organizationId, assignmentTypeId])
  @@index([assignmentTypeId])
}

model OrgMembership {
  id                                String                         @id @default(cuid())
  createdAt                         DateTime                       @default(now()) @db.Timestamptz(6)
  userId                            String
  user                              User                           @relation(fields: [userId], references: [id])
  organizationId                    String
  organization                      Organization                   @relation(fields: [organizationId], references: [id])
  role                              MembershipRole
  isOrgOwner                        Boolean                        @default(false)
  isActive                          Boolean                        @default(true)
  school                            String?
  schoolTeacher                     String?
  grade                             String?
  period                            String?
  documents                         Document[]
  documentComments                  DocumentComment[]
  documentCommentResponses          DocumentCommentResponse[]
  pasteAlerts                       PasteAlert[]
  submissionsGraded                 Submission[]                   @relation("SubmissionGradedBy")
  submissionsUnsubmitted            Submission[]                   @relation("SubmissionUnsubmittedBy")
  submissionActivities              SubmissionActivity[]           @relation("SubmissionActivityActor")
  submissionComments                SubmissionComment[]            @relation("SubmissionCommentProfile")
  ownedAssignmentTypes              AssignmentType[]               @relation("AssignmentTypeOwner")
  classesAsTeacher                  Class[]                        @relation("ClassTeachers")
  classesAsStudent                  Class[]                        @relation("ClassStudents")
  schools                           School[]                       @relation("SchoolTeachers")
  teacherTrainingModuleSessions     TeacherTrainingModuleSession[]
  assignedTeacherTrainings          TeacherTraining[]              @relation("TeacherTrainingAssignments")
  assignmentTypesCustomized         Boolean                        @default(false)
  assignmentTypeAssignments         TeacherAssignmentType[]
  writingPracticeAssignmentsCreated WritingPracticeAssignment[]    @relation("WritingPracticeAssignmentCreator")
  reporterConversations             ReporterConversation[]
  reporterGrowthPlansOwned          ReporterGrowthPlan[]           @relation("ReporterGrowthPlanOwner")
  reporterGrowthPlansAsStudent      ReporterGrowthPlan[]           @relation("ReporterGrowthPlanStudent")
  aiRequestReservations             AiRequestReservation[]

  classAssignmentInsightsGenerated ClassAssignmentInsight[]
  savedThesisPrompts               SavedThesisPrompt[]
  savedDailyPagesPrompts           SavedDailyPagesPrompt[]
  savedAssignments                 SavedAssignment[]
  studentLicenses                  StudentLicense[]

  @@unique([userId, organizationId])
  @@unique([id, organizationId])
  @@map("OrgMembership")
}

model StudentLicense {
  id                      String               @id @default(cuid())
  createdAt               DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  membershipId            String
  organizationId          String
  cohort                  String
  status                  StudentLicenseStatus @default(PENDING)
  source                  StudentLicenseSource @default(STRIPE_CHECKOUT)
  validUntil              DateTime             @db.Timestamptz(6)
  checkoutAttempt         Int                  @default(0)
  amountPaid              Int?
  currency                String?
  stripePriceId           String?
  stripeCustomerId        String?
  stripeSubscriptionId    String?              @unique
  stripeCheckoutSessionId String?              @unique
  stripePaymentIntentId   String?              @unique
  paidAt                  DateTime?            @db.Timestamptz(6)
  revokedAt               DateTime?            @db.Timestamptz(6)
  membership              OrgMembership        @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([membershipId, cohort])
  @@index([organizationId, status, validUntil])
}

/// Stripe retries webhook delivery and does not guarantee ordering. Recording the
/// event id in the same transaction as its state transition makes handling durable
/// and idempotent without trusting a browser redirect.
model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @db.Timestamptz(6)
}

/// Durable admission record created before an AI provider call. Advisory locks
/// serialize each membership and organization budget so concurrent requests
/// cannot all pass a count-then-call race.
model AiRequestReservation {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  feature        String
  membershipId   String
  membership     OrgMembership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([membershipId, feature, createdAt(sort: Desc)])
  @@index([organizationId, feature, createdAt(sort: Desc)])
}

/// A Yawp Reporter chat session. Owned by a teacher (OrgMembership) and scoped
/// to their organization. Holds an ordered transcript of reporter messages.
model ReporterConversation {
  id             String            @id @default(cuid())
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?         @db.Timestamptz(6)
  title          String            @default("New report")
  membershipId   String
  membership     OrgMembership     @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       ReporterMessage[]

  @@index([membershipId, updatedAt(sort: Desc)])
  @@index([organizationId])
}

/// A single turn in a Yawp Reporter conversation. `role` is 'user' or
/// 'assistant'. `toolCalls` optionally records the tool invocations the
/// assistant made to produce its answer (for transparency/auditing).
model ReporterMessage {
  id             String               @id @default(cuid())
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  role           String
  content        String
  toolCalls      Json?
  conversationId String
  conversation   ReporterConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// A saved, forward-looking writing growth plan for one student, produced by
/// the Yawp Reporter. Owned by a teacher (membership) and scoped to their org.
/// Stores a baseline snapshot at creation so later reports can measure progress
/// on the rubric skills the plan targets. `status` is 'active' | 'archived' |
/// 'completed'; only one plan per student is kept active at a time.
model ReporterGrowthPlan {
  id                  String        @id @default(cuid())
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  status              String        @default("active")
  focus               String
  /// Rubric category keys this plan targets (string[]).
  targetSkills        Json
  body                String
  /// { averagePercentage, rubricLevels: { category: level }, capturedAt } at creation.
  baseline            Json
  checkInAt           DateTime?     @db.Timestamptz(6)
  membershipId        String
  membership          OrgMembership @relation("ReporterGrowthPlanOwner", fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentMembershipId String
  student             OrgMembership @relation("ReporterGrowthPlanStudent", fields: [studentMembershipId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([membershipId, studentMembershipId, status])
  @@index([studentMembershipId])
  @@index([organizationId])
}

model Password {
  hash   String
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model School {
  id                        String                 @id @default(cuid())
  createdAt                 DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime               @default(now()) @db.Timestamptz(6)
  name                      String
  code                      String                 @unique
  organizationId            String
  organization              Organization           @relation(fields: [organizationId], references: [id])
  classes                   Class[]
  teachers                  OrgMembership[]        @relation("SchoolTeachers")
  invitations               Invitation[]
  assignmentTypesCustomized Boolean                @default(false)
  assignmentTypeAssignments SchoolAssignmentType[]
}

model SchoolAssignmentType {
  schoolId         String
  assignmentTypeId String
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentType   AssignmentType @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)

  @@id([schoolId, assignmentTypeId])
  @@index([assignmentTypeId])
}

model TeacherAssignmentType {
  membershipId     String
  assignmentTypeId String
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  membership       OrgMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  assignmentType   AssignmentType @relation(fields: [assignmentTypeId], references: [id], onDelete: Cascade)

  @@id([membershipId, assignmentTypeId])
  @@index([assignmentTypeId])
}

model Session {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)
  expirationDate DateTime @default(now()) @db.Timestamptz(6)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  name        String   @unique
  description String?
  value       String
  valueType   String   @default("string")
}

/// A teacher-authored writing-practice assignment. The lesson slugs remain
/// separate from regular assignment types so this feature can roll out without
/// changing the existing essay-assignment data model.
model WritingPracticeAssignment {
  id                    String                           @id @default(cuid())
  createdAt             DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                         @default(now()) @updatedAt @db.Timestamptz(6)
  title                 String
  lessonSlugs           String[]
  problemCount          Int                              @default(5)
  dueAt                 DateTime                         @db.Timestamptz(6)
  instructions          String?
  createdByMembershipId String?
  createdByMembership   OrgMembership?                   @relation("WritingPracticeAssignmentCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  classAssignments      WritingPracticeClassAssignment[]

  @@index([createdByMembershipId])
}

/// Per-class deployment of a writing-practice assignment.
model WritingPracticeClassAssignment {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  assignmentId String
  assignment   WritingPracticeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  classId      String
  class        Class                     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, classId])
  @@index([classId, createdAt(sort: Desc)])
}

// Upload table removed. Videos will be stored in S3 and referenced by key.

model User {
  id           String          @id @default(cuid())
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @db.Timestamptz(6)
