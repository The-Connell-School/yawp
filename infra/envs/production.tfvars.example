# Non-secret production Terraform inputs only (placeholders).
# Live values: Secrets Manager secret yawp/terraform/production-tfvars (us-east-1, JSON). Never commit tfvars.

# yawp_app_origin = "https://ua.yawp.school"
# primary_app_url omitted by default (matches live App Runner: PRIMARY_APP_URL unset)
# free_tier_link_hmac_enabled = false
# legacy_internal_key_allowed = false
# internal_platform_signing_keys_secret_arn = "arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:yawp-internal/production-signing-platform-keys-XXXX"

# Database export objects and eligible manual RDS snapshots are retained for 90 days.
# The scheduled snapshot cleanup logs deletions and always keeps the newest pre-deploy snapshot.
# database_export_retention_days = 90
# manual_snapshot_retention_days = 90
# rds_snapshot_cleanup_schedule_expression = "cron(30 8 * * ? *)"
