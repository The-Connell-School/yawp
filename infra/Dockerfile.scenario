FROM oven/bun:1.3.1 AS bun
FROM node:22.22.0-bookworm-slim AS base
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

FROM base AS build
WORKDIR /app
COPY package.json bun.lock ./
COPY packages/prisma/package.json ./packages/prisma/package.json
COPY services/web-app/package.json ./services/web-app/package.json
RUN bun install --frozen-lockfile --ignore-scripts
COPY packages/prisma/schema.prisma packages/prisma/prisma.config.ts packages/prisma/index.ts ./packages/prisma/
RUN cd packages/prisma && node node_modules/prisma/build/index.js generate
COPY services/web-app/app/utils/internal-scenario.server.ts services/web-app/app/utils/school-year.ts ./services/web-app/app/utils/
COPY services/web-app/scripts/internal-scenario-runner.ts ./services/web-app/scripts/

FROM base
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/packages/prisma ./packages/prisma
COPY --from=build /app/services/web-app ./services/web-app
USER node
ENV NODE_ENV=production
ENTRYPOINT ["bun", "services/web-app/scripts/internal-scenario-runner.ts"]
