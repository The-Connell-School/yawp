#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
QA_VIDEO_HOME=${QA_VIDEO_HOME:-"$HOME/.qa-video-capture"}
KOKORO_ROOT="$QA_VIDEO_HOME/kokoro"
VENV="$KOKORO_ROOT/venv"
MODEL_DIR="$KOKORO_ROOT/model"
MODEL_URL="https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.int8.onnx"
VOICES_URL="https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin"
MODEL_SHA256="6e742170d309016e5891a994e1ce1559c702a2ccd0075e67ef7157974f6406cb"
VOICES_SHA256="bca610b8308e8d99f32e6fe4197e7ec01679264efed0cac9140fe9c29f1fbf7d"
PYTHON=${PYTHON:-python3}

for command in node npm "$PYTHON" ffmpeg ffprobe curl; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "Missing required command: $command" >&2
    exit 1
  fi
done

node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 18 ? 0 : 1)' || {
  echo "Node.js 18 or newer is required." >&2
  exit 1
}

"$PYTHON" -c 'import sys; raise SystemExit(0 if (3, 10) <= sys.version_info[:2] < (3, 14) else 1)' || {
  echo "Python 3.10 through 3.13 is required." >&2
  exit 1
}

cd "$ROOT"
npm ci
./node_modules/.bin/playwright install chromium

mkdir -p "$KOKORO_ROOT" "$MODEL_DIR"
if [ ! -x "$VENV/bin/python" ]; then
  "$PYTHON" -m venv "$VENV"
fi
"$VENV/bin/python" -m pip install --upgrade pip
"$VENV/bin/python" -m pip install -r "$ROOT/requirements.txt"

download_if_missing() {
  url=$1
  target=$2
  if [ -s "$target" ]; then
    return
  fi
  partial="$target.partial"
  curl -fL --retry 3 --output "$partial" "$url"
  mv "$partial" "$target"
}

download_if_missing "$MODEL_URL" "$MODEL_DIR/kokoro-v1.0.int8.onnx"
download_if_missing "$VOICES_URL" "$MODEL_DIR/voices-v1.0.bin"

verify_sha256() {
  target=$1
  expected=$2
  "$PYTHON" - "$target" "$expected" <<'PY'
import hashlib
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
expected = sys.argv[2]
digest = hashlib.sha256(path.read_bytes()).hexdigest()
if digest != expected:
    raise SystemExit(f"SHA-256 mismatch for {path}: expected {expected}, got {digest}")
PY
}

verify_sha256 "$MODEL_DIR/kokoro-v1.0.int8.onnx" "$MODEL_SHA256"
verify_sha256 "$MODEL_DIR/voices-v1.0.bin" "$VOICES_SHA256"

QA_VIDEO_HOME="$QA_VIDEO_HOME" "$ROOT/bin/doctor"

echo
echo "Ready. Install folder under ~/.claude/skills/qa-video-capture or a project's .claude/skills/qa-video-capture."
