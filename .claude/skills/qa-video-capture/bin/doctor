#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
QA_VIDEO_HOME=${QA_VIDEO_HOME:-"$HOME/.qa-video-capture"}
MODEL_DIR=${QA_VIDEO_KOKORO_MODEL_DIR:-"$QA_VIDEO_HOME/kokoro/model"}
PYTHON=${QA_VIDEO_KOKORO_PYTHON:-"$QA_VIDEO_HOME/kokoro/venv/bin/python"}
failed=0

check_command() {
  if command -v "$1" >/dev/null 2>&1; then
    echo "OK command $1"
  else
    echo "MISSING command $1"
    failed=1
  fi
}

for command in node npm ffmpeg ffprobe curl; do
  check_command "$command"
done

if [ -x "$PYTHON" ]; then
  echo "OK Kokoro Python $PYTHON"
  "$PYTHON" -c 'import kokoro_onnx, soundfile; print("OK Python packages kokoro_onnx, soundfile")' || failed=1
else
  echo "MISSING Kokoro Python $PYTHON"
  failed=1
fi

for file in "$MODEL_DIR/kokoro-v1.0.int8.onnx" "$MODEL_DIR/voices-v1.0.bin"; do
  if [ -s "$file" ]; then
    echo "OK model $file"
  else
    echo "MISSING model $file"
    failed=1
  fi
done

if (cd "$ROOT" && node -e 'require("playwright"); console.log("OK Node package playwright")'); then
  :
else
  failed=1
fi

exit "$failed"
