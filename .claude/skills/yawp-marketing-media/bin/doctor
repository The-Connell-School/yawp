#!/bin/sh
set -eu

SKILL_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BASE_URL=${YAWP_MARKETING_BASE_URL:-http://localhost:3000}
failed=0

QA_SKILL=${YAWP_QA_VIDEO_SKILL:-"$SKILL_ROOT/../qa-video-capture"}
if [ ! -f "$QA_SKILL/package.json" ]; then
  QA_SKILL="$HOME/.claude/skills/qa-video-capture"
fi

if [ -f "$QA_SKILL/package.json" ]; then
  QA_SKILL=$(CDPATH= cd -- "$QA_SKILL" && pwd)
  echo "OK qa-video-capture skill $QA_SKILL"
  if [ -x "$QA_SKILL/bin/doctor" ]; then
    "$QA_SKILL/bin/doctor" || failed=1
  else
    echo "MISSING $QA_SKILL/bin/doctor"
    failed=1
  fi
else
  echo "MISSING qa-video-capture skill. Set YAWP_QA_VIDEO_SKILL or install it next to this skill."
  failed=1
fi

for storyboard in "$SKILL_ROOT"/storyboards/*.json; do
  name=$(basename "$storyboard" .json)
  if node "$SKILL_ROOT/scripts/capture_marketing_demo.mjs" --storyboard "$name" --emit-cues "/tmp/yawp-marketing-doctor-$name.json" >/dev/null 2>&1; then
    echo "OK storyboard $name"
  else
    echo "BROKEN storyboard $name"
    failed=1
  fi
  rm -f "/tmp/yawp-marketing-doctor-$name.json"
done

if curl -fsS -o /dev/null --max-time 5 "$BASE_URL"; then
  echo "OK app reachable $BASE_URL"
else
  echo "APP NOT REACHABLE $BASE_URL (run: bun dev)"
fi

exit "$failed"
