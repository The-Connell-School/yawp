# Copy to production-sync.env (gitignored) and `source` before running:
#   chmod 600 /path/to/yawp-production-bastion.pem
#   set -a && source scripts/production-sync.env && set +a && bun run db:sync-local-from-production
#
# --- Production RDS (reachable only from bastion; used for pg_dump over SSH) ---
YAWP_PROD_BASTION_HOST=
YAWP_PROD_BASTION_USER=ec2-user
YAWP_PROD_BASTION_KEY=/path/to/yawp-production-bastion.pem
YAWP_PROD_PG_HOST=yawp-production-postgres.xxxxx.us-east-1.rds.amazonaws.com
YAWP_PROD_PG_PORT=5432
YAWP_PROD_PG_USER=yawp_admin
YAWP_PROD_PG_DB=yawpdb
# RDS password (do not commit). Use single quotes if it contains < ( ) $ etc.
YAWP_PROD_PG_PASSWORD=
#
# --- Local target (database is dropped and recreated) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/yawp

# Full cutover rehearsal (local only):
#   YAWP_CONFIRM=yes bun run db:staging-org-membership-rehearsal

# --- Older snapshot from S3 (not live) — no bastion required ---
# AWS_PROFILE=yawp DATABASE_URL=... bun run db:restore-local-from-s3
