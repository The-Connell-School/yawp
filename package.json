{
  "name": "app",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "overrides": {
    "axios": "^1.20.0",
    "@babel/core": "^7.29.6",
    "baseline-browser-mapping": "^2.11.0",
    "body-parser": "^1.20.9",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12",
    "browserslist": "^4.28.7",
    "compression": "^1.8.2",
    "fast-uri": "^3.1.9",
    "fflate": "^0.4.9",
    "follow-redirects": "^1.16.1",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.2",
    "linkify-it": "^5.0.2",
    "markdown-it": "^14.3.3",
    "morgan": "^1.12.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^6.1.3",
    "@opentelemetry/core": "^2.8.0",
    "protobufjs": "^7.6.5",
    "prosemirror-view": "^1.42.3",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "source-map-js": "^1.2.2",
    "valibot": "^1.4.2",
    "ws": "^8.21.0"
  },
  "scripts": {
    "typecheck": "bun web-app:typecheck",
    "export-env": "export $(grep -v '^#' .env | xargs) ",
    "dev": "bash scripts/worktree-local-setup.sh --no-dev && source .worktree-local/config.env && PORT=\"$DEV_PORT\" bun web-app:dev",
    "web-app:dev": "bun run --cwd services/web-app dev",
    "web-app:test:e2e": "bun run --cwd services/web-app test:e2e",
    "web-app:test:e2e:prepare": "bun run --cwd services/web-app test:e2e:prepare",
    "web-app:test:e2e:preview-access": "bun run --cwd services/web-app test:e2e:preview-access",
    "web-app:test:e2e:smoke": "bun run --cwd services/web-app test:e2e:smoke",
    "web-app:test:e2e:full": "bun run --cwd services/web-app test:e2e:full",
    "web-app:build": "bun run --cwd services/web-app build",
    "web-app:start": "bun run --cwd services/web-app start",
    "web-app:typecheck": "bun run --cwd services/web-app typecheck",
    "web-app:docker:build": "docker build --platform linux/amd64 -t yawp-web-app:latest -f services/web-app/Dockerfile --build-arg YAWP_GIT_COMMIT=$(git rev-parse HEAD) --build-arg YAWP_BUILT_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ) .",
    "web-app:docker:staging:tag": "docker tag yawp-web-app:latest 422348803522.dkr.ecr.us-east-1.amazonaws.com/yawp-staging-web-app:latest",
    "web-app:docker:staging:login": "aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 422348803522.dkr.ecr.us-east-1.amazonaws.com",
    "web-app:docker:staging:push": "bun web-app:docker:staging:login && docker push 422348803522.dkr.ecr.us-east-1.amazonaws.com/yawp-staging-web-app:latest",
    "web-app:docker:production:tag": "docker tag yawp-web-app:latest 422348803522.dkr.ecr.us-east-1.amazonaws.com/yawp-production-web-app:latest",
    "web-app:docker:production:login": "aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 422348803522.dkr.ecr.us-east-1.amazonaws.com",
    "web-app:docker:production:push": "bun web-app:docker:production:login && docker push 422348803522.dkr.ecr.us-east-1.amazonaws.com/yawp-production-web-app:latest",
    "prisma": "bun run --cwd packages/prisma prisma",
    "prisma:generate": "bun run --cwd packages/prisma prisma generate",
    "prisma:migrate-remote": "bun run --cwd packages/prisma migrate-remote",
    "infra:staging:init": "bun export-env && bun run --cwd infra terraform init -backend-config=envs/backends/staging.backend",
    "infra:staging:plan": "bun export-env && bun run --cwd infra terraform plan -var-file=envs/variables/staging.tfvars",
    "infra:staging:apply": "bun export-env && bun run --cwd infra terraform apply -var-file=envs/variables/staging.tfvars",
    "infra:production:init": "bun export-env && bun run --cwd infra terraform init -backend-config=envs/backends/production.backend",
    "infra:production:plan": "bun export-env && bun run --cwd infra terraform plan -var-file=envs/variables/production.tfvars",
    "infra:production:apply": "bun export-env && bun run --cwd infra terraform apply -var-file=envs/variables/production.tfvars",
    "github:preview-config": "bash scripts/github-preview-config.sh",
    "db:restore-local-from-s3": "bash scripts/restore-local-from-s3.sh",
    "db:seed-local-dev": "bun run --cwd packages/prisma seed-local-dev",
    "db:seed-grading-evaluations": "bun run --cwd packages/prisma seed-grading-evaluations",
    "worktree:setup": "bash scripts/worktree-local-setup.sh --no-dev",
    "worktree:setup:fresh": "bash scripts/worktree-local-setup.sh --fresh --no-dev",
    "project": "./bin/project",
    "project:test": "bun test ./scripts/project-agent.test.js",
    "blackboard-lti-mock": "BLACKBOARD_LTI_MOCK_ENABLED=true bun scripts/blackboard-lti-mock/server.mjs",
    "db:fixtures-export-prod-fidelity": "bun run --cwd packages/prisma fixtures:export-prod-fidelity",
    "db:assignment-type-release-gate": "bun run --cwd packages/prisma assignment-type-release-gate",
    "db:refresh-sanitized-preview-data": "bash scripts/refresh-sanitized-preview-data.sh",
    "db:sync-local-from-production": "bash scripts/sync-production-db-to-local.sh",
    "db:practice-full-rollback": "bash scripts/practice-full-rollback.sh",
    "db:staging-org-membership-rehearsal": "bash scripts/staging-org-membership-rehearsal.sh"
  }
}
