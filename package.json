{
  "name": "app",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "web-app:dev": "bun run --cwd services/web-app dev",
    "web-app:build": "bun run --cwd services/web-app build",
    "web-app:start": "bun run --cwd services/web-app start",
    "web-app:typecheck": "bun run --cwd services/web-app typecheck",
    "web-app:docker:build": "docker build -t yawp-web-app:latest -f services/web-app/Dockerfile .",
    "prisma:generate": "bun run --cwd packages/prisma generate",
    "prisma:reset": "bun run --cwd packages/prisma prisma migrate reset",
    "infra:staging:init": "bun run --cwd infra terraform init -backend-config=envs/backends/staging.backend",
    "infra:staging:plan": "bun run --cwd infra terraform plan -var-file=envs/variables/staging.tfvars",
    "infra:staging:apply": "bun run --cwd infra terraform apply -var-file=envs/variables/staging.tfvars"
  }
}
